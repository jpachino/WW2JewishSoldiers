    fieldset { margin-top: 25px; border-radius: 6px; padding: 15px; border: 1px solid #ccc; }
    .trio-row { display: flex; gap: 10px; margin-bottom: 10px; }
    .trio-row .input-group { flex: 1; display: flex; flex-direction: column; }
    .single-row { margin-bottom: 10px; display: flex; flex-direction: column; }
    textarea { resize: vertical; }
  </style>
