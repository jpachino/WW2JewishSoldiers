<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  
  <title><%= __('admin.completedTitle') %></title>
  <link rel="stylesheet" href="/styles/styles.css" />
  <style>
    .preview-box {
      margin-top: 2rem;
      padding: 1rem;
      border: 1px solid #ccc;
      border-radius: 10px;
      background-color: #f9f9f9;
    }
    .record-block {
      border-bottom: 1px solid #ddd;
      margin-bottom: 20px;
      padding-bottom: 10px;
      
    }
    .record-block h3 {
      margin: 0;
      font-size: 1.2rem;
    }
    .field-row {
      display: flex;
      gap: 20px;
      margin-bottom: 8px;
      flex-wrap: wrap;
      
    }
   .field-group {
    flex: 1 1 30%;
    min-width: 180px;
    margin-bottom: 12px;  /* Added more spacing here */
    
  }

    .field-group strong {
      display: block;
      margin-bottom: 4px;
      color: #333;
    }
    table {
      width: 100%;
      border-collapse: collapse;
    }
    th, td {
      border: 1px solid #ccc;
      padding: 8px;
     
      color: #222;  /* Ensure text is not white */


    }
    th {
      background-color: #eee;
    }
    select[name="lang"] {
    font-size: 1rem;
    padding: 4px 8px;
    border-radius: 6px;
  }
  </style>
  <script>
    function getDateLocale(locale) {
      if (locale === 'en') return 'en-GB';  // UK English: dd/mm/yyyy
      if (locale === 'he') return 'he-IL';  // Hebrew Israel
      if (locale === 'ru') return 'ru-RU';  // Russian Russia
    return 'en-GB'; // default fallback
}

  function formatDate(dateStr) {
    if (!dateStr) return '';
    const d = new Date(dateStr);
    const dateLocale = getDateLocale("<%= locale %>");
    return d.toLocaleDateString(dateLocale, { day: '2-digit', month: '2-digit', year: 'numeric' });
}

    function isDateField(field) {
      return ['dob', 'dod', 'aliyadate', 'idf_enlistdate', 'idf_releasedate'].includes(field);
    }
    function submitForm(targetFormId) {
      const checkboxes = document.querySelectorAll('input[name="selectedIds"]:checked');
      const selectedIds = Array.from(checkboxes).map(cb => cb.value);

      if (selectedIds.length === 0) {
        alert("<%= __('admin.selectAtLeastOne') || 'Please select at least one record.' %>");
        return false;
      }

      const targetForm = document.getElementById(targetFormId);
      targetForm.querySelectorAll('input[name="selectedIds"]').forEach(el => el.remove());

      selectedIds.forEach(id => {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'selectedIds';
        input.value = id;
        targetForm.appendChild(input);
      });

      targetForm.submit();
    }

    function previewSelected() {
      const selectedIds = Array.from(document.querySelectorAll('input[name="selectedIds"]:checked')).map(cb => cb.value);
      if (selectedIds.length === 0) {
        alert("<%= __('admin.selectAtLeastOne') || 'Please select at least one record.' %>");
        return;
      }

      const previewBox = document.getElementById("previewArea");
      const container = document.getElementById("previewContent");

      const records = JSON.parse(document.getElementById('soldiers-data').textContent);
      container.innerHTML = "";

      selectedIds.forEach(id => {
        const record = records.find(r => r.id == id);
        if (!record) return;

        const div = document.createElement("div");
        div.classList.add("record-block");

        const heading = document.createElement("h3");
        heading.textContent = "ID: " + record.id;
        div.appendChild(heading);

       const createFieldRow = (...fields) => {
  const row = document.createElement("div");
  row.classList.add("field-row");

  fields.forEach(field => {
    const group = document.createElement("div");
    group.classList.add("field-group");
    group.innerHTML = `<strong>${field}:</strong> ${isDateField(field) ? formatDate(record[field]) : (record[field] ?? '')}`;
    row.appendChild(group);
  });

  return row;
};


        const sections = [
          ["fname", "fnameen", "fnameru"],
          ["lname", "lnameen", "lnameru"],
          ["previouslname", "previouslnameen", "previouslnameru"],
          ["fathername", "fathernameen", "fathernameru"],
          ["mothername", "mothernameen", "mothernameru"],
          ["calledby", "calledbyen", "calledbyru"],
          ["birthcountry", "otherbirthcountry", "birthcity"],
          ["birthcityen", "birthcityru", "gender"],
          ["placeofdeath", "placeofdeathen", "placeofdeathru"],
          ["deathdetails", "deathdetailsen", "deathdetailsru"],
          ["biography", "biographyen", "biographyru"],
          ["otherparticipation", "otherdecoration", "otherdecorationen"],
          ["otherdecorationru", "fightingdesc", "fightingdescen"],
          ["fightingdescru", "dob", "dod"],
          ["aliyadate", "idf_enlistdate", "idf_releasedate"],
          ["medal", "medalen", "medalru"],
          ["remarks", "remarksen", "remarksru"],
          ["linkurl", "useremail", "recordcomplete", "record_complete_date","admin_ready_for_download",
          "admin_approved_date", "downloaded_date"],


          
        ];

        sections.forEach(group => div.appendChild(createFieldRow(...group)));

        container.appendChild(div);
      });

      previewBox.style.display = "block";
      window.scrollTo({ top: previewBox.offsetTop, behavior: 'smooth' });
    }
  </script>
</head>

<body>
  <header>
  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap;">
        <h1><%= __('admin.completedTitle') %></h1>
  </div>

 
  
    
    <nav>
      <a href="/"><%= __('nav.home') %></a>
    </nav>
</div>
</header>
     <!-- 🌐 Language Selector Matching index.ejs -->
       <form method="GET" action="/admin/completedRecords">
    <input type="hidden" name="adminemail" value="<%= adminemail %>" />
    <select name="lang" onchange="this.form.submit()">
      <option value="he" <%= locale === 'he' ? 'selected' : '' %>>עברית</option>
      <option value="en" <%= locale === 'en' ? 'selected' : '' %>>English</option>
      <option value="ru" <%= locale === 'ru' ? 'selected' : '' %>>Русский</option>
    </select>
  </form>
<br>

  <main class="container">
    <% if (saved) { %>
  <div class="success-box">
   
    ✅ <%= __('form.saved_success') || 'Record and files saved successfully!' %>
  </div>
  <% } %>
    <% if (soldiers && soldiers.length > 0) { %>
      <table>
        <thead>
          <tr>
            <th><%= __('form.select') %></th>
            <th>ID</th>
            <th><%= __('form.firstName') %></th>
            <th><%= __('form.lastName') %></th>
            <th><%= __('form.email') %></th>
            <th><%= __('form.dob') %></th>
           
            <th><%= __('form.admin_approved_date') %></th>
            <th><%= __('actions.edit') %></th>
          </tr>
        </thead>
        <tbody>
          <% soldiers.forEach(s => { %>
            <tr>
              <td><input type="checkbox" name="selectedIds" value="<%= s.id %>" /></td>
              <td><%= s.id %></td>
              <td><%= s.fname || '' %></td>
              <td><%= s.lname || '' %></td>
              <td><%= s.useremail %></td>
              <td><%= s.dob ? new Date(s.dob).toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric' }) : '' %></td>
              
              <td><%= s.admin_approved_date ? new Date(s.admin_approved_date).toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric' }) : '' %></td>
              <td><a href="/adminupdateSoldier/<%= s.id %>"><%= __('actions.edit') %></a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>

      <br />

      <form id="excelForm" method="POST" action="/admin/downloadExcel">
        <input type="hidden" name="adminemail" value="<%= adminemail %>" />
        <button type="button" onclick="submitForm('excelForm')">
          <%= __('admin.downloadExcel') %>
        </button>
        <button type="button" onclick="previewSelected()">
          <%= __('admin.previewSelected') || 'Preview Selected' %>
        </button>
      </form>

      <!-- Full Preview Section -->
      <div id="previewArea" class="preview-box" style="display: none;">
        <h2><%= __('admin.previewHeading') || 'Preview Selected Records' %></h2>
        <div id="previewContent"></div>
      </div>

      <!-- Embed soldiers JSON safely -->
      <script id="soldiers-data" type="application/json">
        <%- JSON.stringify(soldiers) %>
      </script>

    <% } else { %>
      <p><%= __('admin.noCompleted') || 'No completed records found.' %></p>
    <% } %>
  </main>
</body>
</html>







