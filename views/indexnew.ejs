<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= __('museum.title') %></title>
  <link rel="stylesheet" href="/styles/styles.css" />
  <style>
    /* --- Header & Nav Styling --- */
    .header-flex {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 15px 0;
    }

    header h1 {
      font-size: 1.8rem;
      margin: 0;
      color: #fff;
      border-inline-start: 4px solid #0038b8;
      padding-inline-start: 15px;
    }

    .nav-bar {
      background: #f8f9fa;
      border-bottom: 1px solid #ddd;
      padding: 10px 0;
    }

    .nav-container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
    }

    .nav-links {
      display: flex;
      gap: 20px;
      align-items: center;
    }

    /* --- Landing Grid Styling --- */
    .landing-container {
      max-width: 1100px;
      margin: 40px auto;
      padding: 0 20px;
      text-align: center;
    }

    .action-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 25px;
      margin-top: 30px;
    }

    .action-card {
      position: relative;
      height: 300px;
      border-radius: 15px;
      overflow: hidden;
      text-decoration: none;
      box-shadow: 0 6px 15px rgba(0,0,0,0.15);
      transition: transform 0.3s ease;
      display: block;
    }

    .action-card:hover { transform: translateY(-5px); }

    .card-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .card-overlay {
      position: absolute;
      top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(0, 0, 0, 0.4);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      box-sizing: border-box;
    }

    .card-text {
      color: white !important;
      font-size: 1.8rem;
      font-weight: 800;
      text-align: center;
      text-shadow: 2px 2px 10px rgba(0,0,0,0.8);
      margin: 0;
    }

    /* --- Footer & Donation Styling --- */
    footer {
      background-color: #f1f3f5;
      border-top: 1px solid #dee2e6;
      padding: 40px 20px;
      margin-top: 60px;
      color: #444;
    }

    .footer-content {
      max-width: 1000px;
      margin: 0 auto;
      text-align: center;
    }

    .bank-details-box {
      background: white;
      padding: 25px;
      border-radius: 8px;
      border: 1px solid #ddd;
      display: inline-block;
      text-align: left;
      margin-top: 20px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.05);
      line-height: 1.6;
    }

    .lang-he .bank-details-box {
      text-align: right;
      direction: rtl;
    }

    .success-box {
      position: fixed;
      top: 30px; left: 50%;
      transform: translateX(-50%);
      z-index: 9999;
      background-color: #d4edda;
      color: #155724;
      padding: 15px 40px;
      border-radius: 50px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    }

    @media (max-width: 768px) {
      .action-grid { grid-template-columns: 1fr; }
      .nav-container { flex-direction: column; text-align: center; }
      header h1 { font-size: 1.4rem; border: none; padding: 0; }
    }
  </style>
</head>

<body class="lang-<%= locale %>">

<header>
  <div class="container header-flex">
    <h1><%= locale === 'he' ? 'מוזיאון הלוחם היהודי במלחמת העולם השנייה' : 'Museum of the Jewish Soldier in World War II' %></h1>
    <div class="logo-area">
      <img src="/images/Outlook-dieerunr.png" alt="Logo" style="height: 80px;">
    </div>
  </div>
</header>

<div class="nav-bar">
  <div class="container nav-container">
    <div class="nav-links">
      <a href="/"><%= __('nav.home') %></a>
      <a href="/aboutMuseum"><%= locale === 'he' ? 'אודות' : 'About' %></a>
      <a href="/donations"><%= locale === 'he' ? 'תרומות' : 'Donations' %></a>
      <a href="/admin-login" class="admin-nav-link">Admin Access</a>
    </div>

    <<div class="lang-switcher">
  <form action="/change-lang" method="get" style="margin:0;" id="langForm">
    <select name="lang" onchange="this.form.submit()" style="border: 2px solid #0038b8; border-radius: 20px; padding: 5px 15px; font-weight: bold; cursor: pointer; background-color: white;">
        <option value="he" <%= locale === 'he' ? 'selected' : '' %>>עברית</option>
        <option value="en" <%= locale === 'en' ? 'selected' : '' %>>English</option>
        <option value="ru" <%= locale === 'ru' ? 'selected' : '' %>>Русский</option>
    </select>
  </form>
</div>
  </div>
</div>

<% if (typeof saved !== 'undefined' && saved) { %>
  <div class="success-box">
    <span>✅ <%= __('form.saved_success') || 'Saved successfully!' %></span>
  </div>
<% } %>

<main class="landing-container">
  <div class="action-grid">
    
    <a href="https://infocenters.co.il/jwm/" class="action-card" target="_blank" rel="noopener noreferrer">
      <img src="/pages/soldierUploads/WebPics/Database Information Center Pic.jpg" alt="Info Center" class="card-image">
      <div class="card-overlay">
        <div class="card-text"><%= locale === 'he' ? 'מרכז מידע' : 'Information Center' %></div>
      </div>
    </a>
       
    <a href="/aboutMuseum" class="action-card">
      <img src="/images/AboutMuseumPic.jpg" alt="About" class="card-image">
      <div class="card-overlay">
        <div class="card-text"><%= locale === 'he' ? 'אודות המוזיאון' : 'About the Museum' %></div>
      </div>
    </a>

    <a href="/addFull" class="action-card">
      <img src="/images/AddSoldierPic.jpg" alt="Add" class="card-image">
      <div class="card-overlay">
        <div class="card-text"><%= __('home.addNewSoldier') %></div>
      </div>
    </a>

    <a href="/booking" class="action-card">
      <img src="/images/BookATour.png" alt="Visit" class="card-image">
      <div class="card-overlay">
        <div class="card-text"><%= locale === 'he' ? 'תיאום ביקור' : 'Schedule a Visit' %></div>
      </div>
    </a>

  </div>
</main>

<footer class="landing-footer">
  <div class="footer-content">
    
    <div class="donation-section" style="margin-bottom: 30px;">
      <a href="/donations" class="btn" style="padding: 15px 50px; font-size: 1.2rem; background-color: #28a745; border-radius: 40px; color: white; text-decoration: none; font-weight: bold; display: inline-block;">
        💙 <%= locale === 'he' ? 'לתרומות ותמיכה - לחצו כאן' : 'Donations & Support - Click Here' %>
      </a>
    </div>

    <div class="bank-details-box">
      <p><strong>Recipient:</strong> The Association for Establishment the Museum of the Jewish Soldier in World War II</p>
      <p><strong>Bank:</strong> Hapoalim (12) | <strong>Branch:</strong> 656 | <strong>Account:</strong> 12-656-66557</p>
      <p><strong>IBAN:</strong> IL44-0126-5600-0000-0066-557 | <strong>SWIFT:</strong> POALILIT</p>
      
      <div style="margin-top: 15px; border-top: 1px solid #ddd; padding-top: 10px;">
        <span>📞 03-3730444</span> | <span>✉️ veteran@jwmww2.com</span>
      </div>
    </div>
    
    <p style="margin-top: 30px; font-size: 0.8rem; color: #888;">
      © <%= new Date().getFullYear() %> Museum of the Jewish Soldier in WWII
    </p>
  </div>
</footer>

<script>
  // Auto-hide success message if record was saved
  const successBox = document.querySelector('.success-box');
  if (successBox) {
    setTimeout(() => {
      successBox.style.transition = 'opacity 0.5s ease';
      successBox.style.opacity = '0';
      setTimeout(() => successBox.remove(), 500);
    }, 5000);
  }
</script>

</body>
</html>