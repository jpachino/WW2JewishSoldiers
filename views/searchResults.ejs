<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= __('nav.searchResults') %></title>
  <link rel="stylesheet" href="/styles/styles.css">
</head>
<body>
  <header>
    <div class="container">
      <h1><%= __('nav.searchResults') %></h1>
      <nav>
        <a href="/"><%= __('nav.home') %></a>
        <a href="/soldierlistFULL"><%= __('nav.soldierList') %></a>
        <a href="/addFULL"><%= __('nav.addSoldier') %></a>
        <a href="/search"><%= __('nav.searchUpdate') %></a>
      </nav>
    </div>
  </header>

  <br><br><br><br><br><br>

  <form method="get" action="">
    <select name="lang" onchange="this.form.submit()">
      <option value="he" <%= (locale === 'he' ? 'selected' : '') %>>עברית</option>
      <option value="en" <%= (locale === 'en' ? 'selected' : '') %>>English</option>
      <option value="ru" <%= (locale === 'ru' ? 'selected' : '') %>>Русский</option>
    </select>
  </form>

  <div class="container">
    <% if (soldiers.length > 0) { %>
      <table>
        <thead>
          <tr>
            <th><%= __('fields.fname') %></th>
            <th><%= __('fields.lname') %></th>
            <th><%= __('fields.birthcountry') %></th>
            <th><%= __('fields.fathername') %></th>
            <th><%= __('fields.dob') %></th>
            <th><%= __('fields.dod') %></th>
            <th><%= __('fields.id') %></th>
            <th><%= __('actions.edit') %></th>
          </tr>
        </thead>
        <tbody>
          <% soldiers.forEach(soldier => { %>
            <tr>
              <td><%= soldier.fname %></td>
              <td><%= soldier.lname %></td>
              <td><%= soldier.birthcountry %></td>
              <td><%= soldier.fathername %></td>
              <td><%= soldier.dob %></td>
              <td><%= soldier.dod %></td>
              <td><%= soldier.id %></td>
              <td><a href="/updateSoldier/<%= soldier.id %>"><%= __('actions.edit') %></a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <p><%= __('messages.noResults') %></p>
    <% } %>

    <a href="/search"><%= __('actions.backToSearch') %></a>
  </div>
</body>
</html>
