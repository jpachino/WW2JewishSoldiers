/**
 * Synchronizes the language values into hidden inputs 
 * based on the checkbox state.
 */
function syncTranslations(checkbox) {
    const idx = checkbox.getAttribute('data-index');
    
    // Grab the translations from the data attributes
    const hebVal = checkbox.getAttribute('data-heb');
    const engVal = checkbox.getAttribute('data-eng');
    const rusVal = checkbox.getAttribute('data-rus');

    // Select the hidden fields
    const inputHeb = document.getElementById('hidden_cat' + idx);
    const inputEng = document.getElementById('hidden_cat' + idx + 'en');
    const inputRus = document.getElementById('hidden_cat' + idx + 'ru');

    if (checkbox.checked) {
        inputHeb.value = hebVal;
        inputEng.value = engVal;
        inputRus.value = rusVal;
    } else {
        inputHeb.value = "";
        inputEng.value = "";
        inputRus.value = "";
    }
}
