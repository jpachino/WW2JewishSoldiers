<script>
    // 1. GLOBAL STATE & VARIABLES
    // Declare rowCount ONCE at the very top
    let rowCount = 0; 

    // 2. PROFILE PIC PREVIEW
    function previewProfilePic(input) {
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                const previewImg = document.getElementById('profile-preview-img');
                const previewContainer = document.getElementById('profile-preview-container');
                if(previewImg) previewImg.src = e.target.result;
                if(previewContainer) previewContainer.style.display = 'block';
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    // 3. MULTIMEDIA ROW GENERATOR
    function addUploadRow() {
        const container = document.getElementById('multimedia-rows');
        const source = document.getElementById('type-options-source');
        
        if (!source) {
            console.error("Multimedia type source dropdown not found!");
            return;
        }

        const currentId = rowCount++;
        const row = document.createElement('div');
        row.className = 'multimedia-row';
        row.style = "border: 1px solid #ccc; border-radius: 8px; margin-bottom: 20px; padding: 20px; background-color: #fff;";

        row.innerHTML = `
            <div style="display: flex; flex-direction: column; gap: 15px;">
                <div>
                    <label style="font-weight:bold;"><%= __('fields.description') %></label>
                    <input type="text" name="m_description[]" class="form-control desc-input" required>
                </div>
                <div>
                    <label style="font-weight:bold;"><%= __('fields.multimedia_type') %></label>
                    <select name="m_type[]" class="form-control type-select" required>
                        ${source.innerHTML}
                    </select>
                </div>
                <div class="file-wrapper">
                    <input type="file" name="m_files" class="file-input" style="display:none;" id="finp_${currentId}" onchange="handleFileSelect(this, 'fname_${currentId}')">
                    <button type="button" class="btn btn-outline-secondary" onclick="document.getElementById('finp_${currentId}').click()">Choose File</button>
                    <span id="fname_${currentId}" class="file-name-span" style="margin-left:10px; color:#666;"><%= __('fields.no_file_chosen') %></span>
                </div>
                <div class="location-wrapper" style="display:none;">
                    <label style="font-weight:bold;">URL / Link</label>
                    <input type="text" name="physical_logical_location[]" class="form-control url-input" placeholder="https://..." disabled>
                </div>
                <button type="button" class="btn btn-danger btn-sm" style="align-self: flex-end;" onclick="this.closest('.multimedia-row').remove()">Remove</button>
            </div>
        `;
        container.appendChild(row);
    }

    // 4. FILE SELECTION & VALIDATION (1.5MB)
    function handleFileSelect(input, spanId) {
        const label = document.getElementById(spanId);
        const mtransEl = document.getElementById('multimedia-translations');
        const mtrans = mtransEl ? mtransEl.dataset : {};
        const file = input.files[0];
        
        const row = input.closest('.multimedia-row');
        const typeSelect = row.querySelector('.type-select');
        const selectedTypeText = typeSelect ? typeSelect.options[typeSelect.selectedIndex].text.toLowerCase() : "";

        if (!file) {
            label.textContent = "<%= __('fields.no_file_chosen') %>";
            return;
        }

        const fileName = file.name.toLowerCase();
        const fileSizeMB = file.size / (1024 * 1024);
        let errorMessage = "";

        const isJpg = fileName.endsWith('.jpg') || fileName.endsWith('.jpeg');
        const isPdf = fileName.endsWith('.pdf');

        const typeIsPicture = selectedTypeText.includes('picture') || selectedTypeText.includes('תמונה') || selectedTypeText.includes('фото');
        const typeIsDoc = selectedTypeText.includes('document') || selectedTypeText.includes('מסמך') || selectedTypeText.includes('документ');

        if (typeIsPicture && !isJpg) errorMessage = mtrans.errMismatchImg || "JPG only";
        else if (typeIsDoc && !isPdf) errorMessage = mtrans.errMismatchPdf || "PDF only";
        else if (!isJpg && !isPdf) errorMessage = mtrans.errExt || "Invalid file type";
        else if (fileSizeMB > 1.5) errorMessage = isPdf ? mtrans.errPdfSize : mtrans.errImgSize;

        if (errorMessage) {
            alert(errorMessage);
            input.value = ""; 
            label.textContent = "<%= __('fields.no_file_chosen') %>";
            label.style.color = "red";
        } else {
            label.textContent = file.name + " (" + fileSizeMB.toFixed(2) + "MB)";
            label.style.color = "green";
        }
    }

    // 5. DOM READY LISTENERS
    document.addEventListener('DOMContentLoaded', () => {
        // Auto-add first multimedia row
        const rowContainer = document.getElementById('multimedia-rows');
        if (rowContainer && rowContainer.children.length === 0) {
            addUploadRow();
        }

        // FORM SUBMIT VALIDATOR
        document.getElementById("soldierForm").addEventListener("submit", function (e) {
            const errorSummary = document.getElementById('error-summary');
            const errorList = document.getElementById('error-list');
            
            if (errorSummary) errorSummary.style.display = 'none';
            if (errorList) errorList.innerHTML = '';
            
            let errors = [];

            // Helper to mark errors
            const markError = (ids, msg) => {
                errors.push(msg);
                ids.forEach(id => {
                    const el = document.getElementById(id);
                    if (el) el.classList.add('is-invalid');
                });
            };

            // Basic Validation
            const fname = document.getElementById('fname')?.value.trim();
            const lname = document.getElementById('lname')?.value.trim();
            if (!fname && !lname) errors.push("Name is required in at least one language.");

            // Multimedia Validation
            document.querySelectorAll('.multimedia-row').forEach((row, idx) => {
                const typeSelect = row.querySelector('.type-select');
                const descInput = row.querySelector('.desc-input');
                const isUrlType = typeSelect.options[typeSelect.selectedIndex].text.match(/URL|קישור|Link|ссылка/i);
                
                if (descInput.value.trim() !== "") {
                    if (isUrlType) {
                        const urlInp = row.querySelector('.url-input');
                        if (!urlInp.value.trim()) errors.push(`Row ${idx+1}: URL is missing.`);
                    } else {
                        const fileInp = row.querySelector('.file-input');
                        if (fileInp.files.length === 0) errors.push(`Row ${idx+1}: File is missing.`);
                    }
                }
            });

            if (errors.length > 0) {
                e.preventDefault();
                if (errorSummary) {
                    errorSummary.style.display = 'block';
                    errors.forEach(err => {
                        const li = document.createElement('li');
                        li.textContent = "❌ " + err;
                        errorList.appendChild(li);
                    });
                    window.scrollTo({ top: errorSummary.offsetTop - 50, behavior: 'smooth' });
                } else {
                    alert(errors.join("\n"));
                }
            }
        });
    });

    // 6. TOGGLE FILE/URL (Delegated Event)
    document.addEventListener('change', function (e) {
        if (e.target && e.target.classList.contains('type-select')) {
            const row = e.target.closest('.multimedia-row');
            const isUrl = e.target.options[e.target.selectedIndex].text.match(/URL|קישור|Link|ссылка/i);
            
            row.querySelector('.file-wrapper').style.display = isUrl ? 'none' : 'block';
            row.querySelector('.location-wrapper').style.display = isUrl ? 'block' : 'none';
            row.querySelector('.file-input').disabled = !!isUrl;
            row.querySelector('.url-input').disabled = !isUrl;
        }
    });

