                        <input type="file" name="m_files[]" class="file-input" accept="image/*,.pdf" 
                               style="display: none;" id="file_input_${currentId}" 
                               onchange="handleFileSelect(this, 'file_name_${currentId}')">
                        
                        <div class="d-flex align-items-center" style="gap: 10px;">
