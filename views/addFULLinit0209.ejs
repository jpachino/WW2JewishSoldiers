                                <%= __('fields.choose_file') %>
                            </button>
                            <small id="file_name_${currentId}" class="text-muted">
                                <%= __('fields.no_file_chosen') %>
                            </small>
                        </div>
                    </div>
                    <div class="location-wrapper" style="display: none;">
                        <label><%= __('fields.url_link') %></label>
                        <input type="text" name="physical_logical_location[]" class="form-control" placeholder="https://...">
                    </div>
                </div>
                <div class="col-md-2 text-right">
                    <label>&nbsp;</label><br>
                    <div style="text-align: right; border-top: 1px solid #eee; pt: 15px; padding-top: 10px;">
                        <button type="button" class="btn btn-danger" onclick="this.closest('.multimedia-row').remove()" style="background-color: #dc3545; color: white; border: none; padding: 8px 20px; border-radius: 4px; cursor: pointer; font-weight: bold;">
                            <%= __('fields.remove') %>
                        </button>
                    </div>
                </div>
            </div>
        `;
        container.appendChild(row);
    }

    // 3. Handle File Selection (CLEANED VERSION)
function handleFileSelect(input, spanId) {
    const label = document.getElementById(spanId);
    if (!label) return;

    if (input.files && input.files[0]) {
        label.textContent = input.files[0].name;
        if (typeof previewProfilePic === "function") {
            previewProfilePic(input);
        }
    } else {
        // Use the raw translation text
        label.textContent = "<%= __('fields.no_file_chosen') %>";
    }
}
    // 4. Toggle Logic for File vs URL (Event Delegation)
    document.addEventListener('change', function (event) {
        if (event.target && event.target.classList.contains('type-select')) {
            const select = event.target;
            const row = select.closest('.multimedia-row');
            const fileWrapper = row.querySelector('.file-wrapper');
            const locationWrapper = row.querySelector('.location-wrapper');
            const selectedValue = select.value; 

            if (selectedValue.includes('URL') || selectedValue.includes('קישור')) {
                fileWrapper.style.display = 'none';
                locationWrapper.style.display = 'block';
                fileWrapper.querySelector('input').value = ''; 
            } else {
                fileWrapper.style.display = 'block';
                locationWrapper.style.display = 'none';
                locationWrapper.querySelector('input').value = '';
            }
        }
    });

    // 5. Profile Pic Preview logic
    function previewProfilePic(input) {
        const allInputs = document.querySelectorAll('.file-input');
        // Only preview if it's the first file input on the page
        if (input === allInputs[0] && input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                const previewImg = document.getElementById('profile-preview-img');
                const previewContainer = document.getElementById('profile-preview-container');
                previewImg.src = e.target.result;
                previewContainer.style.display = 'block';
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    // 6. Date Validation Helper
    function isValidDate(d) {
        if (!d) return true; // Allow empty
        const regex = /^(0?[1-9]|[12][0-9]|3[01])-(0?[1-9]|1[012])-(18|19|20)?[0-9]{2}$/;
        if (!regex.test(d)) return false;

        const [day, month, year] = d.split('-').map(Number);
        const jsDate = new Date(year, month - 1, day);

        return (
            jsDate.getFullYear() === year &&
            jsDate.getMonth() === month - 1 &&
            jsDate.getDate() === day
        );
    }

    // 7. Form Submit Listener
    // Replace your existing document.getElementById("soldierForm").addEventListener...
document.getElementById("soldierForm").addEventListener("submit", function (e) {
    const errorSummary = document.getElementById('error-summary');
    const errorList = document.getElementById('error-list');
    
    // 1. Reset UI
    errorSummary.style.display = 'none';
    errorList.innerHTML = '';
    document.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));
    
    let errors = [];
    let firstErrorElement = null;

    // Helper to style fields and track the first error for scrolling
    const markError = (ids, message) => {
        errors.push(message);
        ids.forEach(id => {
            const el = document.getElementById(id);
            if (el) {
                el.classList.add('is-invalid');
                if (!firstErrorElement) firstErrorElement = el;
            }
        });
    };

    // --- 1. GROUP VALIDATIONS (Using your specific wording) ---
    if (!document.getElementById('army').value && !document.getElementById('resistance').value && !document.getElementById('partizan').value) {
        markError(['army', 'resistance', 'partizan'], "Missing Service Type: Please select at least one: Army, Resistance, or Partizan.");
    }

    if (!document.getElementById('fname').value.trim() && !document.getElementById('fnameen').value.trim() && !document.getElementById('fnameru').value.trim()) {
        markError(['fname', 'fnameen', 'fnameru'], "Missing First Name: Please provide a name in at least one language.");
    }

    if (!document.getElementById('lname').value.trim() && !document.getElementById('lnameen').value.trim() && !document.getElementById('lnameru').value.trim()) {
        markError(['lname', 'lnameen', 'lnameru'], "Missing Last Name: Please provide a last name in at least one language.");
    }

    // --- 2. SINGLE FIELD VALIDATIONS (Using your specific wording) ---
    
    // Gender
    const genderEl = document.getElementById('gender');
    if (!genderEl || !genderEl.value) {
        markError(['gender'], "Gender is required.");
    }

    // Birth Country (Fixed ID to birthcountryId)
    const countryEl = document.getElementById('birthcountryId');
    if (!countryEl || !countryEl.value) {
        markError(['birthcountryId'], "Birth Country is required.");
    }

    // Submitter Email
    const emailEl = document.getElementById('useremail');
    if (!emailEl || !emailEl.value.trim()) {
        markError(['useremail'], "Submitter Email is required.");
    } else {
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(emailEl.value.trim())) {
            markError(['useremail'], "Submitter Email format is invalid.");
        }
    }

    // Submitter Names & Phone
    if (!document.getElementById('fname_soldier_submitter').value.trim()) {
        markError(['fname_soldier_submitter'], "Submitter First Name is required.");
    }
    if (!document.getElementById('lname_soldier_submitter').value.trim()) {
        markError(['lname_soldier_submitter'], "Submitter Last Name is required.");
    }
    if (!document.getElementById('phone_soldier_submitter').value.trim()) {
        markError(['phone_soldier_submitter'], "Submitter Phone Number is required.");
    }
   // --- 3. DATE VALIDATION (Integrated into the Error List) ---
const dateFields = ["dob", "dod", "aliyadate"];

// This regex allows: YYYY or MM-YYYY or DD-MM-YYYY
const flexibleDateRegex = /^(\d{4}|(0[1-9]|1[0-2])-\d{4}|(0[1-9]|[12][0-9]|3[01])-(0[1-9]|1[0-2])-\d{4})$/;

dateFields.forEach(f => {
    const el = document.getElementById(f);
    if (el && el.value.trim()) {
        const val = el.value.trim();
        
        // Check against the regex first
        if (!flexibleDateRegex.test(val)) {
            markError([f], `❌ <%= __('errors.invalid_date') %>: ${f.toUpperCase()} (YYYY, MM-YYYY, or DD-MM-YYYY)`);
        } 
    }
});

   // --- 4. SHOW SUMMARY & SCROLL ---
    if (errors.length > 0) {
        e.preventDefault(); 

        errors.forEach(err => {
            const li = document.createElement('li');
            li.innerHTML = "❌ " + err; 
            errorList.appendChild(li);
        });

        errorSummary.style.display = 'block';

        // Scroll to the error summary box with a 100px offset from the top
        const yOffset = -100; 
        const y = errorSummary.getBoundingClientRect().top + window.pageYOffset + yOffset;
        window.scrollTo({ top: y, behavior: 'smooth' });

        if (firstErrorElement) {
            // Wait for scroll to finish, then focus the input
            setTimeout(() => {
                firstErrorElement.focus({ preventScroll: true }); 
                // We use preventScroll: true so the focus doesn't "jump" the page again
            }, 800);
        }
        return false;
    }
});
</script>
<script>
/**
 * Synchronizes the language values into hidden inputs 
 * based on the checkbox state.
 */
function syncTranslations(checkbox) {
    const idx = checkbox.getAttribute('data-index');
    
    // Grab the translations from the data attributes
    const hebVal = checkbox.getAttribute('data-heb');
    const engVal = checkbox.getAttribute('data-eng');
    const rusVal = checkbox.getAttribute('data-rus');

    // Select the hidden fields
    const inputHeb = document.getElementById('hidden_cat' + idx);
    const inputEng = document.getElementById('hidden_cat' + idx + 'en');
    const inputRus = document.getElementById('hidden_cat' + idx + 'ru');

    if (checkbox.checked) {
        inputHeb.value = hebVal;
        inputEng.value = engVal;
        inputRus.value = rusVal;
    } else {
        inputHeb.value = "";
        inputEng.value = "";
        inputRus.value = "";
    }
}
</script>
</body>
