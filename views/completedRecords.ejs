<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= __('admin.completedTitle') %></title>
  <link rel="stylesheet" href="/styles/styles.css" />
  <style>
    main.container { margin-top: 1.5rem; }
    .preview-box { margin-top: 2rem; padding: 1rem; border: 1px solid #ccc; border-radius: 10px; background-color: #f9f9f9; }
    .record-block { border-bottom: 1px solid #ddd; margin-bottom: 20px; padding-bottom: 10px; }
    .field-row { display: flex; gap: 20px; margin-bottom: 8px; flex-wrap: wrap; }
    .field-group { flex: 1 1 30%; min-width: 180px; margin-bottom: 12px; }
    .field-group strong { display: block; margin-bottom: 4px; color: #333; }
    table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
    th, td { border: 1px solid #ccc; padding: 10px; text-align: left; }
    
    th { 
        background-color: #e0e0e0; /* Slightly darker grey for better contrast */
        color: #000000;            /* Force text to be pure black */
        font-weight: bold;         /* Make headers stand out */
    }
    .success-box { background-color: #d4edda; color: #155724; padding: 15px; border-radius: 8px; margin-bottom: 20px; border: 1px solid #c3e6cb; }

  </style>
</head>

<body>
  <div id="ejs-config" 
       data-soldiers='<%- JSON.stringify(soldiers).replace(/'/g, "&apos;") %>'
       data-alert-msg="<%= __('admin.selectAtLeastOne') || 'Please select at least one record.' %>">
  </div>

  <header>
    <div class="container">
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap;">
        <h1><%= __('admin.completedTitle') %></h1>
      </div>
      <nav><a href="/"><%= __('nav.home') %></a></nav>
    </div>
  </header>

  <div class="container" style="margin-top: 1rem;">
    <form method="GET" action="/admin/completedRecords">
      <input type="hidden" name="adminemail" value="<%= adminemail %>" />
      <select name="lang" onchange="this.form.submit()">
        <option value="he" <%= locale === 'he' ? 'selected' : '' %>>עברית</option>
        <option value="en" <%= locale === 'en' ? 'selected' : '' %>>English</option>
        <option value="ru" <%= locale === 'ru' ? 'selected' : '' %>>Русский</option>
      </select>
    </form>
  </div>

  <main class="container">
    <% if (typeof saved !== 'undefined' && saved) { %>
      <div class="success-box" id="successMsg">
        ✅ <%= __('form.saved_success') || 'Record saved successfully!' %>
      </div>
    <% } %>

    <% if (soldiers && soldiers.length > 0) { %>
      <div style="overflow-x: auto; max-height: 500px; border: 1px solid #ddd;">
        <table>
          <thead>
            <tr>
              <th><%= __('actions.edit') %></th>
              <th>ID</th>
              <th><%= __('form.firstName') %></th>
              <th><%= __('form.lastName') %></th>
              <th><%= __('form.email') %></th>
              <th><%= __('form.dob') %></th>
              <th><%= __('form.admin_approved_date') %></th>
              <th><%= __('fields.downloaded_date') %></th> 
              <th><%= __('form.select') %></th>
              <!--<input type="checkbox" id="selectAll" onclick="toggleSelectAll(this)"> 
            <%= __('form.select') %>-->
            </tr>
          </thead>
          <tbody>
            <% soldiers.forEach(s => { %>
  <tr>
    <td>
      <a href="/adminUpdateSoldier/<%= s.id %>?adminemail=<%= adminemail %>">
        <%= __('actions.edit') %>
      </a>
    </td>
    <td>A<%= s.id %></td>
    <td>
        <%= s.fname || s.fnameen || s.fnameru || '' %>
    </td>
    <td>
        <%= s.lname || s.lnameen || s.lnameru || '' %>
    </td>
    <td><%= s.useremail %></td>
    <td><%= s.dob || '' %></td>
    <td><%= s.admin_approved_date || '' %></td>
    <td><%= s.downloaded_date || '' %></td>
    <td><input type="checkbox" name="selectedIds" value="<%= s.id %>" /></td>
  </tr>
<% }) %>
          </tbody>
        </table>
      </div>

      <br />
      <form id="excelForm" method="POST" action="/admin/downloadExcel">
        <input type="hidden" name="adminemail" value="<%= adminemail %>" />
        <button type="button" onclick="submitForm('excelForm')">
          <%= __('admin.downloadPackage') || 'Download ZIP Package' %>
      </button>
        <!--<button type="button" onclick="previewSelected()">
          <%= __('admin.previewSelected') || 'Preview Selected' %>
        </button>-->
      </form>

      <!--<div id="previewArea" class="preview-box" style="display: none;">
        <h2><%= __('admin.previewHeading') || 'Preview Selected Records' %></h2>
        <div id="previewContent"></div>
      </div>-->
    <% } else { %>
      <p><%= __('admin.noCompleted') || 'No completed records found.' %></p>
    <% } %>
  </main>

  <script>
    function toggleSelectAll(source) {
    const checkboxes = document.querySelectorAll('input[name="selectedIds"]');
    checkboxes.forEach(cb => cb.checked = source.checked);
  }

    function submitForm(targetFormId) {
      const config = document.getElementById('ejs-config');
      const checkboxes = document.querySelectorAll('input[name="selectedIds"]:checked');
      const selectedIds = Array.from(checkboxes).map(cb => cb.value);

      if (selectedIds.length === 0) {
        alert(config.getAttribute('data-alert-msg'));
        return;
      }

      const targetForm = document.getElementById(targetFormId);
      targetForm.querySelectorAll('input[name="selectedIds"]').forEach(el => el.remove());
      
      selectedIds.forEach(id => {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'selectedIds';
        input.value = id;
        targetForm.appendChild(input);
      });
      targetForm.submit();
    }

    function previewSelected() {
      const config = document.getElementById('ejs-config');
      const selectedIds = Array.from(document.querySelectorAll('input[name="selectedIds"]:checked')).map(cb => cb.value);
      
      if (selectedIds.length === 0) {
        alert(config.getAttribute('data-alert-msg'));
        return;
      }

      const previewBox = document.getElementById("previewArea");
      const container = document.getElementById("previewContent");
      const records = JSON.parse(config.getAttribute('data-soldiers'));
      
      container.innerHTML = "";

      selectedIds.forEach(id => {
        const record = records.find(r => r.id == id);
        if (!record) return;

        const div = document.createElement("div");
        div.classList.add("record-block");
        div.innerHTML = "<h3>ID: A" + record.id + "</h3>";

        // Define groups for preview layout
        const layout = [
          ["fname", "lname", "useremail"],
          ["dob", "dod", "aliyadate"],
          ["admin_approved_date", "downloaded_date"],
          ["biography", "fightingdesc", "remarks"]
        ];

        layout.forEach(group => {
          const row = document.createElement("div");
          row.classList.add("field-row");
          group.forEach(field => {
            const val = record[field] || '';
            row.innerHTML += '<div class="field-group"><strong>' + field + '</strong> ' + val + '</div>';
          });
          div.appendChild(row);
        });

        container.appendChild(div);
      });

      previewBox.style.display = "block";
      window.scrollTo({ top: previewBox.offsetTop, behavior: 'smooth' });
    }

    // Auto-hide success message
    const successBox = document.getElementById('successMsg');
    if (successBox) {
      setTimeout(() => {
        successBox.style.transition = 'opacity 0.5s ease';
        successBox.style.opacity = '0';
        setTimeout(() => {
          successBox.remove();
          const url = new URL(window.location);
          url.searchParams.delete('saved');
          window.history.replaceState({}, document.title, url.toString());
        }, 500);
      }, 5000);
    }
  </script>
</body>
</html>