<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= __('add_soldier') %></title>
  <link rel="stylesheet" href="/styles/styles.css" />
  <style>
    .info-box {
      background-color: #f8f9fa;
      border-left: 6px solid #007bff;
      padding: 20px;
      margin: 20px auto;
      max-width: 800px;
      border-radius: 6px;
      font-family: Arial, sans-serif;
      line-height: 1.6;
      color: #333;
    }

    form {
      max-width: 1000px;
      margin: 0 auto;
    }

    fieldset {
      margin-top: 25px;
      border-radius: 6px;
      padding: 15px;
      border: 1px solid #ccc;
    }

    .trio-row {
      display: flex;
      gap: 10px;
      margin-bottom: 10px;
    }

    .trio-row .input-group {
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .single-row {
      margin-bottom: 10px;
      display: flex;
      flex-direction: column;
    }

    textarea {
      resize: vertical;
    }

    .lang-switcher {
      float: right;
      margin-left: 20px;
    }
  </style>
</head>
<body>
  <header>
    <div class="container">
      <h1><%= __('add_soldier') %></h1>
      <nav>
        <a href="/"><%= __('home') %></a>
        <a href="/soldierlistFULL"><%= __('soldier_list') %></a>
        <a href="/addfull"><%= __('add_soldier') %></a>
        <a href="/search"><%= __('search_update') %></a>

        <form method="get" action="" class="lang-switcher">
          <select name="lang" onchange="this.form.submit()">
            <option value="he" <%= locale === 'he' ? 'selected' : '' %>>עברית</option>
            <option value="en" <%= locale === 'en' ? 'selected' : '' %>>English</option>
            <option value="ru" <%= locale === 'ru' ? 'selected' : '' %>>Русский</option>
          </select>
        </form>
      </nav>
    </div>
  </header>

  <br /><br /><br /><br /><br />

  <div class="info-container">
    <div class="info-box">
      <strong><%= __('registration_info_title') %></strong><br /><br />
      <%= __('registration_info_text') %>
      <br /><br />
      <strong><%= __('thanks') %></strong>
    </div>
  </div>

  <form action="/addfull" method="POST">
    <!-- FIELDSET: Basic Information -->
    <fieldset>
      <legend><%= __('basic_info') %></legend>
      <div class="trio-row">
        <div class="input-group">
          <label for="fname"><%= __('first_name') %></label>
          <input type="text" name="fname" id="fname" />
        </div>
        <div class="input-group">
          <label for="fnameen"><%= __('first_name_en') %></label>
          <input type="text" name="fnameen" id="fnameen" />
        </div>
        <div class="input-group">
          <label for="fnameru"><%= __('first_name_ru') %></label>
          <input type="text" name="fnameru" id="fnameru" />
        </div>
      </div>

      <div class="trio-row">
        <div class="input-group">
          <label for="lname"><%= __('last_name') %></label>
          <input type="text" name="lname" id="lname" />
        </div>
        <div class="input-group">
          <label for="lnameen"><%= __('last_name_en') %></label>
          <input type="text" name="lnameen" id="lnameen" />
        </div>
        <div class="input-group">
          <label for="lnameru"><%= __('last_name_ru') %></label>
          <input type="text" name="lnameru" id="lnameru" />
        </div>
      </div>

      <div class="trio-row">
        <div class="input-group">
          <label for="previouslname"><%= __('previous_last_name') %></label>
          <input type="text" name="previouslname" id="previouslname" />
        </div>
        <div class="input-group">
          <label for="previouslnameen"><%= __('previous_last_name_en') %></label>
          <input type="text" name="previouslnameen" id="previouslnameen" />
        </div>
        <div class="input-group">
          <label for="previouslnameru"><%= __('previous_last_name_ru') %></label>
          <input type="text" name="previouslnameru" id="previouslnameru" />
        </div>
      </div>
    </fieldset>

    <!-- FIELDSET: Family -->
    <fieldset>
      <legend><%= __('family_info') %></legend>
      <% ['fathername', 'mothername', 'calledby'].forEach(function(field) { %>
        <div class="trio-row">
          <div class="input-group">
            <label for="<%= field %>"><%= __(field) %></label>
            <input type="text" name="<%= field %>" id="<%= field %>" />
          </div>
          <div class="input-group">
            <label for="<%= field + 'en' %>"><%= __(field + '_en') %></label>
            <input type="text" name="<%= field + 'en' %>" id="<%= field + 'en' %>" />
          </div>
          <div class="input-group">
            <label for="<%= field + 'ru' %>"><%= __(field + '_ru') %></label>
            <input type="text" name="<%= field + 'ru' %>" id="<%= field + 'ru' %>" />
          </div>
        </div>
      <% }); %>
    </fieldset>

    <!-- FIELDSET: Birth & Death -->
    <fieldset>
      <legend><%= __('birth_death') %></legend>
      <div class="single-row">
        <label for="birthcountry"><%= __('birth_country') %></label>
        <input type="text" name="birthcountry" id="birthcountry" />
      </div>
      <div class="single-row">
        <label for="otherbirthcountry"><%= __('other_birth_country') %></label>
        <input type="text" name="otherbirthcountry" id="otherbirthcountry" />
      </div>

      <div class="trio-row">
        <div class="input-group">
          <label for="birthcity"><%= __('birth_city') %></label>
          <input type="text" name="birthcity" id="birthcity" />
        </div>
        <div class="input-group">
          <label for="birthcityen"><%= __('birth_city_en') %></label>
          <input type="text" name="birthcityen" id="birthcityen" />
        </div>
        <div class="input-group">
          <label for="birthcityru"><%= __('birth_city_ru') %></label>
          <input type="text" name="birthcityru" id="birthcityru" />
        </div>
      </div>

      <div class="single-row">
        <label for="gender"><%= __('gender') %></label>
        <input type="text" name="gender" id="gender" />
      </div>

      <div class="trio-row">
        <div class="input-group">
          <label for="placeofdeath"><%= __('place_of_death') %></label>
          <input type="text" name="placeofdeath" id="placeofdeath" />
        </div>
        <div class="input-group">
          <label for="placeofdeathen"><%= __('place_of_death_en') %></label>
          <input type="text" name="placeofdeathen" id="placeofdeathen" />
        </div>
        <div class="input-group">
          <label for="placeofdeathru"><%= __('place_of_death_ru') %></label>
          <input type="text" name="placeofdeathru" id="placeofdeathru" />
        </div>
      </div>

      <div class="trio-row">
        <div class="input-group">
          <label for="deathdetails"><%= __('death_details') %></label>
          <textarea name="deathdetails" id="deathdetails"></textarea>
        </div>
        <div class="input-group">
          <label for="deathdetailsen"><%= __('death_details_en') %></label>
          <textarea name="deathdetailsen" id="deathdetailsen"></textarea>
        </div>
        <div class="input-group">
          <label for="deathdetailsru"><%= __('death_details_ru') %></label>
          <textarea name="deathdetailsru" id="deathdetailsru"></textarea>
        </div>
      </div>
    </fieldset>

    <!-- FIELDSET: Biography & Participation -->
    <fieldset>
      <legend><%= __('biography_participation') %></legend>

      <div class="trio-row">
        <div class="input-group">
          <label for="biography"><%= __('biography') %></label>
          <textarea name="biography" id="biography"></textarea>
        </div>
        <div class="input-group">
          <label for="biographyen"><%= __('biography_en') %></label>
          <textarea name="biographyen" id="biographyen"></textarea>
        </div>
        <div class="input-group">
          <label for="biographyru"><%= __('biography_ru') %></label>
          <textarea name="biographyru" id="biographyru"></textarea>
        </div>
      </div>

      <div class="single-row">
        <label for="otherparticipation"><%= __('other_participation') %></label>
        <input type="text" name="otherparticipation" id="otherparticipation" />
      </div>

      <div class="trio-row">
        <div class="input-group">
          <label for="otherdecoration"><%= __('other_decoration') %></label>
          <input type="text" name="otherdecoration" id="otherdecoration" />
        </div>
        <div class="input-group">
          <label for="otherdecorationen"><%= __('other_decoration_en') %></label>
          <input type="text" name="otherdecorationen" id="otherdecorationen" />
        </div>
        <div class="input-group">
          <label for="otherdecorationru"><%= __('other_decoration_ru') %></label>
          <input type="text" name="otherdecorationru" id="otherdecorationru" />
        </div>
      </div>
    </fieldset>

    <!-- FIELDSET: IDF & Army Service -->
    <fieldset>
      <legend><%= __('idf_service') %></legend>

      <div class="trio-row">
        <div class="input-group">
          <label for="fightingdesc"><%= __('fighting_description') %></label>
          <textarea name="fightingdesc" id="fightingdesc"></textarea>
        </div>
        <div class="input-group">
          <label for="fightingdescen"><%= __('fighting_description_en') %></label>
          <textarea name="fightingdescen" id="fightingdescen"></textarea>
        </div>
        <div class="input-group">
          <label for="fightingdescru"><%= __('fighting_description_ru') %></label>
          <textarea name="fightingdescru" id="fightingdescru"></textarea>
        </div>
      </div>

      <div class="single-row">
        <label for="idf_otherforce"><%= __('idf_other_force') %></label>
        <input type="text" name="idf_otherforce" id="idf_otherforce" />
      </div>

      <div class="single-row">
        <label for="idf_otherrank"><%= __('idf_other_rank') %></label>
        <input type="text" name="idf_otherrank" id="idf_otherrank" />
      </div>

      <div class="trio-row">
        <div class="input-group">
          <label for="idf_desc"><%= __('idf_description') %></label>
          <textarea name="idf_desc" id="idf_desc"></textarea>
        </div>
        <div class="input-group">
          <label for="idf_descen"><%= __('idf_description_en') %></label>
          <textarea name="idf_descen" id="idf_descen"></textarea>
        </div>
        <div class="input-group">
          <label for="idf_descru"><%= __('idf_description_ru') %></label>
          <textarea name="idf_descru" id="idf_descru"></textarea>
        </div>
      </div>

      <div class="single-row">
        <label for="idf_serviceplace"><%= __('idf_service_place') %></label>
        <input type="text" name="idf_serviceplace" id="idf_serviceplace" />
      </div>

      <div class="single-row">
        <label for="idf_platoonname"><%= __('idf_platoon_name') %></label>
        <input type="text" name="idf_platoonname" id="idf_platoonname" />
      </div>
    </fieldset>

    <!-- FIELDSET: Dates & Medals -->
    <fieldset>
      <legend><%= __('dates_medals') %></legend>
      <label for="dob"><%= __('date_of_birth') %></label>
      <input type="date" name="dob" id="dob" />

      <label for="dod"><%= __('date_of_death') %></label>
      <input type="date" name="dod" id="dod" />

      <label for="aliyadate"><%= __('aliya_date') %></label>
      <input type="date" name="aliyadate" id="aliyadate" />

      <label for="idf_enlistdate"><%= __('idf_enlist_date') %></label>
      <input type="date" name="idf_enlistdate" id="idf_enlistdate" />

      <label for="idf_releasedate"><%= __('idf_release_date') %></label>
      <input type="date" name="idf_releasedate" id="idf_releasedate" />

      <div class="trio-row">
        <div class="input-group">
          <label for="medal"><%= __('medal') %></label>
          <input type="text" name="medal" id="medal" />
        </div>
        <div class="input-group">
          <label for="medalen"><%= __('medal_en') %></label>
          <input type="text" name="medalen" id="medalen" />
        </div>
        <div class="input-group">
          <label for="medalru"><%= __('medal_ru') %></label>
          <input type="text" name="medalru" id="medalru" />
        </div>
      </div>
    </fieldset>

    <!-- FIELDSET: Remarks -->
    <fieldset>
      <legend><%= __('remarks_notes') %></legend>
      <label for="remarks"><%= __('remarks') %></label>
      <textarea name="remarks" id="remarks"></textarea>

      <label for="remarksen"><%= __('remarks_en') %></label>
      <textarea name="remarksen" id="remarksen"></textarea>

      <label for="remarksru"><%= __('remarks_ru') %></label>
      <textarea name="remarksru" id="remarksru"></textarea>

      <label for="linkurl"><%= __('link_url') %></label>
      <input type="url" name="linkurl" id="linkurl" />
    </fieldset>

    <button type="submit"><%= __('submit') %></button>
  </form>
</body>
</html>
