<div class="form-section" style="margin-top: 25px; text-align: start;">
    <label class="roboto-bold" style="font-size: 1.0rem; border-bottom: 2px solid #ddd; padding-bottom: 5px; margin-bottom: 15px; display: block;">
        <%= __('fields.categories') %>
    </label>

    <div class="category-grid">
    <% 
        // 1. Create a "Searchable" array of what is currently in the DB
        const savedValues = [
            (soldier.cat1 || "").trim(), (soldier.cat2 || "").trim(),
            (soldier.cat3 || "").trim(), (soldier.cat4 || "").trim(),
            (soldier.cat5 || "").trim(), (soldier.cat6 || "").trim(),
            (soldier.cat7 || "").trim(), (soldier.cat8 || "").trim()
        ];

        category.forEach((c, index) => { 
            const i = index + 1;
            const fieldName = "cat" + i;
            
            const masterHeb = (c.title_heb || "").trim();
            const masterEng = (c.title_eng || "").trim();
            const masterRus = (c.title_rus || "").trim();

            // 2. The Check: Does this specific category exist in our saved array?
            const isChecked = savedValues.includes(masterHeb) || 
                              savedValues.includes(masterEng) || 
                              savedValues.includes(masterRus);
            
            let displayLabel = masterHeb;
            if (locale === 'en') { displayLabel = masterEng; }
            else if (locale === 'ru') { displayLabel = masterRus; }
    %>
        <div class="category-card">
            <input type="checkbox" 
                   id="check_<%= fieldName %>" 
                   data-index="<%= i %>"
                   data-heb="<%= masterHeb %>"
                   data-eng="<%= masterEng %>"
                   data-rus="<%= masterRus %>"
                   onchange="syncTranslations(this)"
                   <%= isChecked ? 'checked' : '' %>>
            
            <label for="check_<%= fieldName %>">
                <%= displayLabel %>
            </label>

            <input type="hidden" name="cat<%= i %>" id="hidden_cat<%= i %>" value="<%= isChecked ? masterHeb : '' %>">
            <input type="hidden" name="cat<%= i %>en" id="hidden_cat<%= i %>en" value="<%= isChecked ? masterEng : '' %>">
            <input type="hidden" name="cat<%= i %>ru" id="hidden_cat<%= i %>ru" value="<%= isChecked ? masterRus : '' %>">
        </div>
    <% }) %>
    </div>

