<script>
document.addEventListener('DOMContentLoaded', () => {
    /**
     * 1. DATE VALIDATION & SYNC LOGIC
     */
    const dateGroups = document.querySelectorAll('.date-entry-group');
    const currentYear = new Date().getFullYear();

    const getMaxDays = (month, year) => {
        const m = parseInt(month, 10);
        const y = parseInt(year, 10);
        if (!m) return 31;
        if (m === 2) {
            if (!y) return 29; 
            const isLeap = (y % 4 === 0 && y % 100 !== 0) || (y % 400 === 0);
            return isLeap ? 29 : 28;
        }
        return [4, 6, 9, 11].includes(m) ? 30 : 31;
    };

    const triggerDateError = (inputEl, groupEl, message) => {
        const errorSpan = groupEl.querySelector('.date-error-msg');
        if (inputEl) {
            inputEl.value = '';
            inputEl.classList.add('input-error');
            setTimeout(() => inputEl.classList.remove('input-error'), 800);
        }
        if (errorSpan) {
            errorSpan.textContent = message;
            setTimeout(() => { errorSpan.textContent = ''; }, 3500);
        }
    };

    const checkDateChronology = () => {
        const dobVal = document.getElementById('dob').value; // Hidden input DD-MM-YYYY
        const dodVal = document.getElementById('dod').value;

        if (dobVal && dodVal) {
            // Helper to convert DD-MM-YYYY or YYYY to a comparable Date object
            const parseToDate = (str) => {
                const parts = str.split('-');
                if (parts.length === 3) return new Date(parts[2], parts[1] - 1, parts[0]);
                if (parts.length === 1) return new Date(parts[0], 0, 1);
                return null;
            };

            const dobDate = parseToDate(dobVal);
            const dodDate = parseToDate(dodVal);

            if (dobDate && dodDate && dodDate < dobDate) {
                const dodGroup = document.getElementById('dod').closest('.date-entry-group');
                dodGroup.querySelectorAll('input[type="text"]').forEach(inp => inp.value = '');
                document.getElementById('dod').value = '';
                triggerDateError(null, dodGroup, "Date of Death cannot be before Date of Birth");
            }
        }
    };

    dateGroups.forEach(group => {
        const hiddenInput = group.querySelector('input[type="hidden"]');
        const dayInp = group.querySelector('.day');
        const monthInp = group.querySelector('.month');
        const yearInp = group.querySelector('.year');
        const inputs = [dayInp, monthInp, yearInp];

        const validateAndSync = () => {
            let d = dayInp.value.trim(), m = monthInp.value.trim(), y = yearInp.value.trim();

            if (y !== '' && y.length === 4 && parseInt(y, 10) > currentYear) {
                triggerDateError(yearInp, group, `Year cannot exceed ${currentYear}`);
                y = '';
            }
            if (m !== '' && parseInt(m, 10) > 12) {
                triggerDateError(monthInp, group, "Month 01-12");
                m = '';
            }
            if (d !== '') {
                const max = getMaxDays(m, y);
                if (parseInt(d, 10) > max) {
                    triggerDateError(dayInp, group, `Max ${max} days`);
                    d = '';
                }
            }

            const padD = d ? d.padStart(2, '0') : '';
            const padM = m ? m.padStart(2, '0') : '';
            
            // Format for Hidden Input: DD-MM-YYYY (Standardized)
            let final = '';
            if (y && m && d) final = `${padD}-${padM}-${y}`;
            else if (y && m) final = `${padM}-${y}`;
            else if (y) final = y;

            hiddenInput.value = final;
            checkDateChronology();
        };

        inputs.forEach((el, index) => {
            el.addEventListener('input', () => {
                el.value = el.value.replace(/\D/g, '');
                validateAndSync();
                if (el.value.length >= el.maxLength && index < inputs.length - 1) inputs[index + 1].focus();
            });
            el.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace' && el.value === '' && index > 0) inputs[index - 1].focus();
            });
            el.addEventListener('blur', () => {
                if (el.value && el.value.length === 1 && !el.classList.contains('year')) el.value = el.value.padStart(2, '0');
                validateAndSync();
            });
        });
    });

    /**
     * 2. BATTLE LOGIC
     */
    const battleContainer = document.getElementById('battle-container');
    const addBattleBtn = document.getElementById('add-battle-entry');
    if (addBattleBtn && battleContainer) {
        const template = document.getElementById('battle-template');
        addBattleBtn.addEventListener('click', () => {
            const clone = document.importNode(template.content, true);
            battleContainer.appendChild(clone);
        });
        battleContainer.addEventListener('click', (e) => {
            if (e.target.classList.contains('remove-entry')) {
                const row = e.target.closest('.battle-row');
                const idInp = row.querySelector('input[name="battleId[]"]');
                if (idInp && idInp.value) {
                    // Logic for existing records to be deleted on server
                    const delInput = document.createElement('input');
                    delInput.type = 'hidden';
                    delInput.name = 'delete_battle_id[]';
                    delInput.value = idInp.value;
                    document.getElementById('soldierForm').appendChild(delInput);
                }
                row.remove();
            }
        });
    }

    /**
     * 3. MULTIMEDIA MASTER VALIDATION (On Submit)
     */
    document.getElementById('soldierForm').addEventListener('submit', function(e) {
        const mRows = document.querySelectorAll('.multimedia-row');
        const mtrans = document.getElementById('multimedia-translations').dataset;
        let errors = [];

        mRows.forEach((row, index) => {
            if (row.style.display === 'none') return;

            const typeSelect = row.querySelector('.type-select');
            const descInput = row.querySelector('input[name="m_description[]"]');
            const fileInput = row.querySelector('.file-input');
            const urlInput = row.querySelector('input[name="physical_logical_location[]"]');
            
            const selectedType = typeSelect.value;
            const selectedText = typeSelect.options[typeSelect.selectedIndex].text.toLowerCase();
            const isUrlType = selectedText.match(/URL|קישור|Link|ссылка/i);
            
            const hasFile = fileInput && fileInput.files.length > 0;
            const hasUrl = urlInput && urlInput.value.trim() !== "";
            const hasDescription = descInput.value.trim() !== "";
            const sourceProvided = isUrlType ? hasUrl : hasFile;

            // Row Completion Logic
            if (selectedType !== "" || sourceProvided || hasDescription) {
                if (selectedType === "") errors.push(`Row #${index + 1}: Select a type.`);
                if (!sourceProvided) errors.push(`Row #${index + 1}: Provide a ${isUrlType ? 'URL' : 'file'}.`);
                if (!hasDescription) errors.push(`Row #${index + 1}: Provide a description.`);

                // File Type Check
                if (hasFile && !isUrlType) {
                    const fileName = fileInput.files[0].name.toLowerCase();
                    const isJpg = fileName.endsWith('.jpg') || fileName.endsWith('.jpeg');
                    const isPdf = fileName.endsWith('.pdf');
                    const typeIsPic = selectedText.includes('picture') || selectedText.includes('תמונה');
                    const typeIsDoc = selectedText.includes('document') || selectedText.includes('מסמך');

                    if (typeIsPic && !isJpg) errors.push(`Row #${index + 1}: ${mtrans.errMismatchImg || 'JPG only for pictures'}`);
                    if (typeIsDoc && !isPdf) errors.push(`Row #${index + 1}: ${mtrans.errMismatchPdf || 'PDF only for documents'}`);
                }
            }
        });

        if (errors.length > 0) {
            e.preventDefault();
            alert(errors.join("\n"));
            return false;
        }
    });
});

/**
 * GLOBAL FUNCTIONS (Needed outside DOMContentLoaded for onclick attributes)
 */
let rowCount = 0;
function addUploadRow() {
    const container = document.getElementById('multimedia-rows');
    const source = document.getElementById('type-options-source');
    const currentId = rowCount++;
    const row = document.createElement('div');
    row.className = 'multimedia-row';
    row.style = "border: 1px solid #ccc; border-radius: 8px; margin-bottom: 20px; padding: 20px; background-color: #fff;";

    row.innerHTML = `
        <div style="display: flex; flex-direction: column; gap: 15px;">
            <div>
                <label style="font-weight:bold;"><%= __('fields.description') %></label>
                <input type="text" name="m_description[]" class="form-control">
            </div>
            <div>
                <label style="font-weight:bold;"><%= __('fields.multimedia_type') %></label>
                <select name="m_type[]" class="form-control type-select">
                    ${source.innerHTML}
                </select>
            </div>
            <div class="file-wrapper">
                <input type="file" name="m_files[]" class="file-input" style="display:none;" id="finp_${currentId}" onchange="handleFileSelect(this, 'fname_${currentId}')">
                <button type="button" class="btn-file-trigger" onclick="document.getElementById('finp_${currentId}').click()">Choose File</button>
                <span id="fname_${currentId}" style="margin-left:10px; color:#666;">No file chosen</span>
            </div>
            <div class="location-wrapper" style="display:none;">
                <label style="font-weight:bold;">URL / Link</label>
                <input type="text" name="physical_logical_location[]" class="form-control" placeholder="https://...">
            </div>
            <button type="button" class="btn btn-danger btn-sm" style="align-self: flex-end;" onclick="this.closest('.multimedia-row').remove()">Remove</button>
        </div>
    `;
    container.appendChild(row);
}
function handleFileSelect(input, spanId) {
    const span = document.getElementById(spanId);
    if (input.files[0]) {
        span.textContent = input.files[0].name;
        span.style.color = "green";
    }
}

function syncTranslations(checkbox) {
    const idx = checkbox.getAttribute('data-index');
    const inputs = [
        document.getElementById('hidden_cat' + idx),
        document.getElementById('hidden_cat' + idx + 'en'),
        document.getElementById('hidden_cat' + idx + 'ru')
    ];
    const vals = [checkbox.getAttribute('data-heb'), checkbox.getAttribute('data-eng'), checkbox.getAttribute('data-rus')];
    
    inputs.forEach((inp, i) => {
        if (inp) inp.value = checkbox.checked ? vals[i] : "";
    });
}
document.addEventListener('change', function (e) {
    if (e.target && e.target.classList.contains('type-select')) {
        const row = e.target.closest('.multimedia-row');
        const selectedText = e.target.options[e.target.selectedIndex].text;
        
        // Detect if it's a URL/Link type
        const isUrl = selectedText.match(/URL|קישור|Link|ссылка/i);
        
        const fileWrapper = row.querySelector('.file-wrapper');
        const locationWrapper = row.querySelector('.location-wrapper');
        const fileInput = row.querySelector('.file-input');
        const urlInput = row.querySelector('input[name="physical_logical_location[]"]');

        if (isUrl) {
            // 1. Show URL field, Hide File field
            fileWrapper.style.display = 'none';
            locationWrapper.style.display = 'block';
            
            // 2. Disable file input so browser ignores it
            fileInput.disabled = true; 
            fileInput.value = ""; 
            
            // 3. Enable URL input
            urlInput.disabled = false;
        } else {
            // 1. Show File field, Hide URL field
            fileWrapper.style.display = 'block';
            locationWrapper.style.display = 'none';
            
            // 2. Enable file input
            fileInput.disabled = false;
            
            // 3. Disable and clear URL input
            urlInput.disabled = true;
            urlInput.value = ""; 
        }
    }
});
</script>
</body>
</html>
