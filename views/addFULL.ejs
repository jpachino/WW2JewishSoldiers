<fieldset>
  <legend><%= __('sections.battleHistory') %></legend>
  <div id="battle-container">
    <div class="battle-row mb-3">

      <!-- Year -->
        <div class="trio-row">
      <label><%= __('fields.year') %></label>
      <input type="number" name="battleyear[]" class="form-control">
      
       </div>   
      <!-- Front -->
       <div class="trio-row">
      <label><%= __('fields.front') %></label>
      <input type="text" name="front[]" class="form-control">
      <label><%= __('fields.fronten') %></label>
      <input type="text" name="fronten[]" class="form-control">
      <label><%= __('fields.frontru') %></label>
      <input type="text" name="frontru[]" class="form-control">
        </div>
      <!-- Battle -->
       <div class="trio-row">
      <label><%= __('fields.battle') %></label>
      <input type="text" name="battle[]" class="form-control">
      <label><%= __('fields.battleen') %></label>
      <input type="text" name="battleen[]" class="form-control">
      <label><%= __('fields.battleru') %></label>
      <input type="text" name="battleru[]" class="form-control">
       </div>
      <!-- Medal -->
       <div class="trio-row">
      <label><%= __('fields.medal') %></label>
      <input type="text" name="battle_medal[]" class="form-control">
      <label><%= __('fields.medalen') %></label>
      <input type="text" name="battle_medalen[]" class="form-control">
      <label><%= __('fields.medalru') %></label>
      <input type="text" name="battle_medalru[]" class="form-control">
       </div>
        <div class="trio-row">
      <label><%= __('fields.degreerank') %></label>
      <input type="text" name="degreerank[]" class="form-control">
      <label><%= __('fields.degreeranken') %></label>
      <input type="text" name="degreeranken[]" class="form-control">
      <label><%= __('fields.degreerankru') %></label>
      <input type="text" name="degreerankru[]" class="form-control">
       </div>
        <div class="trio-row">
      <label><%= __('fields.job') %></label>
      <input type="text" name="job[]" class="form-control">
      <label><%= __('fields.joben') %></label>
      <input type="text" name="joben[]" class="form-control">
      <label><%= __('fields.jobru') %></label>
      <input type="text" name="jobru[]" class="form-control">
       </div>
      <!-- Details -->
       <div class="trio-row">
      <label><%= __('fields.details') %></label>
      <textarea name="battle_details[]" class="form-control" rows="3"></textarea>
      <label><%= __('fields.detailsen') %></label>
      <textarea name="battle_detailsen[]" class="form-control" rows="3"></textarea>
      <label><%= __('fields.detailsru') %></label>
      <textarea name="battle_detailsru[]" class="form-control" rows="3"></textarea>
       </div> 
    </div>
  </div>
  <button type="button" id="add-battle" class="btn btn-sm btn-outline-secondary mt-2">
    <%= __('sections.addAnotherBattle') %>
  </button>
</fieldset>


<script>
const addBattleBtn = document.getElementById('add-battle');
const battleContainer = document.getElementById('battle-container');

addBattleBtn.addEventListener('click', () => {
  const firstRow = battleContainer.querySelector('.battle-row');
  const newRow = firstRow.cloneNode(true);

  // Clear values in cloned inputs
  newRow.querySelectorAll('input, textarea').forEach(el => el.value = '');
  
  battleContainer.appendChild(newRow);
});
</script>


<fieldset>
  <legend><%= __('sections.uploads') %></legend>

  <label class="file-upload-label">
    <%= __('form.upload_files') %>
  </label>

  <div class="custom-file-input">
    <!-- Hide the default file input UI -->
    <input type="file" id="files" name="files" multiple onchange="updateFileName()" hidden />
    
    <!-- This button triggers the hidden input -->
    <button type="button" onclick="document.getElementById('files').click()">
      <%= __('form.select_files') %>
    </button>

    <!-- This shows the selected filenames or 'No files chosen' -->
    <span id="file-label"><%= __('form.no_file_chosen') %></span>
  </div>
</fieldset>

