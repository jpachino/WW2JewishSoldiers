<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Update Full</title>
  <link rel="stylesheet" href="/styles/styles.css">
</head>
<body>
  <header>
    <div class="container">
       
      <h1>Update Soldier</h1>
      <nav>
        <a href="/">Update Full</a>
        <a href="/soldierlistFULL">Soldier List</a>
        <a href="/addFULL">Add New Soldier</a>
        <a href="/search">Search and Update Soldier</a>
       </nav>
    </div>
  </header>
  <br><br><br>
  <form action="/updateFull/<%= soldier._id %>" method="post">
    
    <fieldset>
      <legend>Basic Information</legend>
      <label for="fname">First Name:</label>
      <input type="text" name="fname" id="fname" />
  
      <label for="fnameen">First Name (EN):</label>
      <input type="text" name="fnameen" id="fnameen" />
  
      <label for="fnameru">First Name (RU):</label>
      <input type="text" name="fnameru" id="fnameru" />
  
      <label for="lname">Last Name:</label>
      <input type="text" name="lname" id="lname" />
  
      <label for="lnameen">Last Name (EN):</label>
      <input type="text" name="lnameen" id="lnameen" />
  
      <label for="lnameru">Last Name (RU):</label>
      <input type="text" name="lnameru" id="lnameru" />
  
      <label for="previouslname">Previous Last Name:</label>
      <input type="text" name="previouslname" id="previouslname" />
  
      <label for="previouslnameen">Previous Last Name (EN):</label>
      <input type="text" name="previouslnameen" id="previouslnameen" />
  
      <label for="previouslnameru">Previous Last Name (RU):</label>
      <input type="text" name="previouslnameru" id="previouslnameru" />
    </fieldset>
  
    <fieldset>
      <legend>Family</legend>
      <label for="fathername">Father's Name:</label>
      <input type="text" name="fathername" id="fathername" />
  
      <label for="fathernameen">Father's Name (EN):</label>
      <input type="text" name="fathernameen" id="fathernameen" />
  
      <label for="fathernameru">Father's Name (RU):</label>
      <input type="text" name="fathernameru" id="fathernameru" />
  
      <label for="mothername">Mother's Name:</label>
      <input type="text" name="mothername" id="mothername" />
  
      <label for="mothernameen">Mother's Name (EN):</label>
      <input type="text" name="mothernameen" id="mothernameen" />
  
      <label for="mothernameru">Mother's Name (RU):</label>
      <input type="text" name="mothernameru" id="mothernameru" />
  
      <label for="calledby">Called By:</label>
      <input type="text" name="calledby" id="calledby" />
  
      <label for="calledbyen">Called By (EN):</label>
      <input type="text" name="calledbyen" id="calledbyen" />
  
      <label for="calledbyru">Called By (RU):</label>
      <input type="text" name="calledbyru" id="calledbyru" />
    </fieldset>
  
    <fieldset>
      <legend>Birth & Death</legend>
      <label for="birthcountry">Birth Country:</label>
      <input type="text" name="birthcountry" id="birthcountry" />
  
      <label for="otherbirthcountry">Other Birth Country:</label>
      <input type="text" name="otherbirthcountry" id="otherbirthcountry" />
  
      <label for="birthcity">Birth City:</label>
      <input type="text" name="birthcity" id="birthcity" />
  
      <label for="birthcityen">Birth City (EN):</label>
      <input type="text" name="birthcityen" id="birthcityen" />
  
      <label for="birthcityru">Birth City (RU):</label>
      <input type="text" name="birthcityru" id="birthcityru" />
  
      <label for="gender">Gender:</label>
      <input type="text" name="gender" id="gender" />
  
      <label for="placeofdeath">Place of Death:</label>
      <input type="text" name="placeofdeath" id="placeofdeath" />
  
      <label for="placeofdeathen">Place of Death (EN):</label>
      <input type="text" name="placeofdeathen" id="placeofdeathen" />
  
      <label for="placeofdeathru">Place of Death (RU):</label>
      <input type="text" name="placeofdeathru" id="placeofdeathru" />
  
      <label for="deathdetails">Death Details:</label>
      <textarea name="deathdetails" id="deathdetails"></textarea>
  
      <label for="deathdetailsen">Death Details (EN):</label>
      <textarea name="deathdetailsen" id="deathdetailsen"></textarea>
  
      <label for="deathdetailsru">Death Details (RU):</label>
      <textarea name="deathdetailsru" id="deathdetailsru"></textarea>
    </fieldset>
  
    <fieldset>
      <legend>Biography & Participation</legend>
      <label for="biography">Biography:</label>
      <textarea name="biography" id="biography"></textarea>
  
      <label for="biographyen">Biography (EN):</label>
      <textarea name="biographyen" id="biographyen"></textarea>
  
      <label for="biographyru">Biography (RU):</label>
      <textarea name="biographyru" id="biographyru"></textarea>
  
      <label for="otherparticipation">Other Participation:</label>
      <input type="text" name="otherparticipation" id="otherparticipation" />
  
      <label for="otherdecoration">Other Decoration:</label>
      <input type="text" name="otherdecoration" id="otherdecoration" />
  
      <label for="otherdecorationen">Other Decoration (EN):</label>
      <input type="text" name="otherdecorationen" id="otherdecorationen" />
  
      <label for="otherdecorationru">Other Decoration (RU):</label>
      <input type="text" name="otherdecorationru" id="otherdecorationru" />
    </fieldset>
  
    <fieldset>
      <legend>IDF & Army Service</legend>
      <label for="fightingdesc">Fighting Description:</label>
      <textarea name="fightingdesc" id="fightingdesc"></textarea>
  
      <label for="fightingdescen">Fighting Description (EN):</label>
      <textarea name="fightingdescen" id="fightingdescen"></textarea>
  
      <label for="fightingdescru">Fighting Description (RU):</label>
      <textarea name="fightingdescru" id="fightingdescru"></textarea>
  
      <label for="idf_otherforce">IDF Other Force:</label>
      <input type="text" name="idf_otherforce" id="idf_otherforce" />
  
      <label for="idf_otherrank">IDF Other Rank:</label>
      <input type="text" name="idf_otherrank" id="idf_otherrank" />
  
      <label for="idf_desc">IDF Description:</label>
      <textarea name="idf_desc" id="idf_desc"></textarea>
  
      <label for="idf_descen">IDF Description (EN):</label>
      <textarea name="idf_descen" id="idf_descen"></textarea>
  
      <label for="idf_descru">IDF Description (RU):</label>
      <textarea name="idf_descru" id="idf_descru"></textarea>
  
      <label for="idf_serviceplace">IDF Service Place:</label>
      <input type="text" name="idf_serviceplace" id="idf_serviceplace" />
  
      <label for="idf_platoonname">IDF Platoon Name:</label>
      <input type="text" name="idf_platoonname" id="idf_platoonname" />
    </fieldset>
  
    <fieldset>
      <legend>Dates & Medals</legend>
      <label for="dob">Date of Birth:</label>
      <input type="date" name="dob" id="dob" />
  
      <label for="dod">Date of Death:</label>
      <input type="date" name="dod" id="dod" />
  
      <label for="aliyadate">Aliya Date:</label>
      <input type="date" name="aliyadate" id="aliyadate" />
  
      <label for="idf_enlistdate">IDF Enlist Date:</label>
      <input type="date" name="idf_enlistdate" id="idf_enlistdate" />
  
      <label for="idf_releasedate">IDF Release Date:</label>
      <input type="date" name="idf_releasedate" id="idf_releasedate" />
  
      <label for="medal">Medal:</label>
      <input type="text" name="medal" id="medal" />
  
      <label for="medalen">Medal (EN):</label>
      <input type="text" name="medalen" id="medalen" />
  
      <label for="medalru">Medal (RU):</label>
      <input type="text" name="medalru" id="medalru" />
    </fieldset>
  
    <fieldset>
      <legend>Remarks & Final Notes</legend>
      <label for="remarks">Remarks:</label>
      <textarea name="remarks" id="remarks"></textarea>
  
      <label for="remarksen">Remarks (EN):</label>
      <textarea name="remarksen" id="remarksen"></textarea>
  
      <label for="remarksru">Remarks (RU):</label>
      <textarea name="remarksru" id="remarksru"></textarea>
  
      <label for="linkurl">Link URL:</label>
      <input type="url" name="linkurl" id="linkurl" />
    </fieldset>
  
    <button type="submit">Submit</button>
  </form>
  <a href="/soldierlistFULL">Back to Soldier List</a>
</body>
</html>
