  <fieldset>
  <legend><%= __('sections.datesmedals') %></legend>

  <label for="dob"><%= __('fields.dob') %>:</label>
  <input type="date" name="dob" id="dob" />

  <label for="dod"><%= __('fields.dod') %>:</label>
  <input type="date" name="dod" id="dod" />

