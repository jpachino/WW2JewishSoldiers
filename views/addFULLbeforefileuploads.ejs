  <label for="idf_releasedate"><%= __('fields.idf_releasedate') %>:</label>
  <input type="date" name="idf_releasedate" id="idf_releasedate" />

  <div class="trio-row">
    <div class="trio-row">
  <div class="input-group">
    <label for="medal"><%= __('fields.medal') %>:</label>
    <select name="medal" id="medal">
      <option value="">{ <%= __('select') %> }</option>
      <% medals.forEach(m => { %>
        <option value="<%= m.id %>"><%= m.title %></option>
      <% }); %>
    </select>
  </div>

  <div class="input-group">
    <label for="medalen"><%= __('fields.medalen') %>:</label>
    <select name="medalen" id="medalen">
      <option value="">{ <%= __('select') %> }</option>
      <% medals.forEach(m => { %>
        <option value="<%= m.id %>"><%= m.title %></option>
      <% }); %>
    </select>
    <!--<input type="text" name="medalen" id="medalen" />-->
  </div>

  <div class="input-group">
    <label for="medalru"><%= __('fields.medalru') %>:</label>
    <select name="medalru" id="medalru">
      <option value="">{ <%= __('select') %> }</option>
      <% medals.forEach(m => { %>
        <option value="<%= m.id %>"><%= m.title %></option>
      <% }); %>
    </select>
    <!--<input type="text" name="medalru" id="medalru" />-->
  </div>
</div>

    
