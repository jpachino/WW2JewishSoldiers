<!DOCTYPE html>
<html lang="<%= locale %>">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= __('home.title') %></title>
  <link rel="stylesheet" href="/styles/styles.css" />
  <style>
    /* Custom spacing for the home page description */
    .description-text {
      font-size: 1rem;
      line-height: 1.6;
      margin-bottom: 2rem;
      white-space: pre-line;
      color: #333;
      max-width: 900px;
      margin-left: auto;
      margin-right: auto;
    }

    /* Text alignment based on language */
    .lang-he { direction: rtl; text-align: justify; }
    .lang-en, .lang-ru { direction: ltr; text-align: left; }
    
    /* Ensure the choice form buttons look consistent */
    .choice-form p { width: 100%; margin-bottom: 1rem; }
 
    /* Specific styling for the centered search box */
    .search-container {
      max-width: 500px;
      margin: 80px auto;
      text-align: center;
    }

    .success-box {
      position: fixed;
      top: 30px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 99999;
      background-color: #d4edda;
      color: #155724;
      border: 1px solid #c3e6cb;
      padding: 15px 40px;
      border-radius: 50px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.3);
      font-weight: bold;
      display: flex;
      align-items: center;
      gap: 10px;
    }
  </style>
</head>

<body>

<header>
  <div class="container header-flex">
    <h1><%= __('home.title') %></h1>
    <div class="logo-area">
      <img src="/images/Outlook-dieerunr.png" alt="Logo">
    </div>
  </div>
  <div class="container">
    <nav class="nav-flex">
      <a href="/"><%= __('nav.home') %></a>
      <a href="/admin-login" class="admin-nav-link">Admin Access</a>
    </nav>
  </div>
</header>

<% if (typeof saved !== 'undefined' && saved) { %>
<div class="success-box">
  <span>✅ <%= __('form.saved_success') || 'Record and files saved successfully!' %></span>
</div>
<% } %>

<div class="container" style="margin-top: 2rem;">
  <form action="/change-lang" method="get" style="box-shadow: none; background: transparent; padding: 0;">
    <label style="font-size: 0.8rem; margin-bottom: 5px;">Select Language / בחר שפה</label>
    <select name="lang" class="lang-select" onchange="this.form.submit()" style="width: auto; min-width: 150px;">
        <option value="he" <%= locale === 'he' ? 'selected' : '' %>>עברית</option>
        <option value="en" <%= locale === 'en' ? 'selected' : '' %>>English</option>
        <option value="ru" <%= locale === 'ru' ? 'selected' : '' %>>Русский</option>
    </select>
  </form>
</div>

<main class="container">
  <div class="description-text lang-<%= locale %>">
    <%= __('home.description') %>
  </div>

  <form class="choice-form" id="choiceForm">
    <p><strong><%= __('home.chooseAction') %></strong></p>
    <button type="button" onclick="redirectToAdd()"><%= __('home.addNewSoldier') %></button>
    <button type="button" onclick="redirectToChange()"><%= __('home.changeSoldierInfo') %></button>
  </form>
</main>

<script>
  function redirectToAdd() {
    window.location.href = '/addFull';
  }

  function redirectToChange() {
    const lang = '<%= locale %>';
    window.location.href = `/search?lang=${lang}`;
  }

  // Keyboard shortcut backup (Ctrl + Shift + A)
  document.addEventListener('keydown', function(e) {
    if (e.ctrlKey && e.shiftKey && e.key === 'A') {
      window.location.href = '/admin-login';
    }
  });

  // Auto-hide success message
  const successBox = document.querySelector('.success-box');
  if (successBox) {
    setTimeout(() => {
      successBox.style.transition = 'opacity 0.5s ease';
      successBox.style.opacity = '0';
      setTimeout(() => successBox.remove(), 500);
    }, 5000);
  }
</script>
</body>
</html>