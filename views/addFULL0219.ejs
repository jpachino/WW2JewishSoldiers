    <label class="roboto-bold" style="font-size: 1.0rem; border-bottom: 2px solid #ddd; padding-bottom: 5px; margin-bottom: 15px; display: block;">
        <%= __('fields.categories') %>
    </label>

    <div class="category-grid">
        <% category.forEach((c, index) => { 
            let displayLabel = c.title_heb;
            if (locale === 'en') displayLabel = c.title_eng;
            else if (locale === 'ru') displayLabel = c.title_rus;

            let i = index + 1;
            let fieldName = "cat" + i;
            
            // Checking against Hebrew (the primary key) is usually most reliable
            let isChecked = (soldier[fieldName] === c.title_heb);
        %>
            <div class="category-card">
                <input type="checkbox" 
                       id="check_<%= fieldName %>" 
                       data-index="<%= i %>"
                       data-heb="<%= c.title_heb %>"
                       data-eng="<%= c.title_eng %>"
                       data-rus="<%= c.title_rus %>"
                       onchange="syncTranslations(this)"
                       <%= isChecked ? 'checked' : '' %>>
                
                <label for="check_<%= fieldName %>">
                    <%= displayLabel %>
                </label>

                <input type="hidden" name="cat<%= i %>" id="hidden_cat<%= i %>" value="<%= isChecked ? c.title_heb : '' %>">
                <input type="hidden" name="cat<%= i %>en" id="hidden_cat<%= i %>en" value="<%= isChecked ? c.title_eng : '' %>">
                <input type="hidden" name="cat<%= i %>ru" id="hidden_cat<%= i %>ru" value="<%= isChecked ? c.title_rus : '' %>">
            </div>
        <% }) %>
    </div>
</div>
