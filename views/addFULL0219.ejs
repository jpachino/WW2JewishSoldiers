<fieldset class="is-multimedia-container" style="border: 1px solid #ddd; padding: 20px; border-radius: 8px;">
        <legend style="padding: 0 10px; font-weight: bold;"><%= __('sections.uploads') %></legend>

        <div id="multimedia-translations" 
             data-err-ext="<%= __('errors.invalid_extension') || 'Invalid file extension' %>"
             data-err-mismatch-img="<%= __('errors.mismatch_image') || 'Please upload an image for this type' %>"
             data-err-mismatch-pdf="<%= __('errors.mismatch_pdf') || 'Please upload a PDF for this type' %>"
             data-err-type-required="<%= __('errors.type_required') || 'Please select a multimedia type' %>"
             style="display:none;"></div>

        <div class="upload-container">
            <div class="help-box-alert" style="margin-bottom: 20px; padding: 15px; background-color: #e7f3fe; border-left: 4px solid #007bff; border-radius: 4px;">
                <strong>ℹ️</strong> <%= __('multimedia_info.help_text') %>
            </div>
            
            <p class="instruction-text" style="color: #0038b8; font-size: 0.9rem; margin-top: 5px;">
                <strong><%= __('fields.profile_pic_instruction') %></strong>
            </p>

            <div id="multimedia-rows">
                <div class="multimedia-row" style="border: 1px solid #ccc; border-radius: 8px; margin-bottom: 25px; padding: 20px; background-color: #fff; position: relative;">
                    <div class="row-layout" style="display: flex; flex-direction: column; gap: 15px;">
                        
                        <div class="field-group">
                            <label style="display: block; font-weight: bold;"><%= __('fields.description') %></label>
                            <input type="text" name="m_description[]" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #ccc;">
                        </div>
                        
                        <div class="field-group">
                            <label style="display: block; font-weight: bold;"><%= __('fields.multimedia_type') %></label>
                            <select name="m_type[]" class="form-control type-select" onchange="toggleUploadType(this)" style="width: 100%; padding: 10px; height: 45px;">
                                <option value="">-- <%= __('fields.select_option') %> --</option>
                                <% if (locals.multimedia_type_TBL) { %>
                                    <% multimedia_type_TBL.forEach(type => { 
                                        let typeLabel = locale === 'he' ? type.title_heb : (locale === 'ru' ? type.title_rus : type.title_eng);
                                    %>
                                        <option value="<%= type.title_heb %>" data-type-eng="<%= (type.title_eng || '').toLowerCase() %>">
                                            <%= typeLabel %>
                                        </option>
                                    <% }) %>
                                <% } %>
                            </select>
                        </div>

                        <div class="field-group">
                            <div class="file-wrapper">
                                <label style="display: block; font-weight: bold;"><%= __('fields.file_upload') %></label>
                                <input type="file" name="m_files[]" class="file-input" accept=".jpg,.jpeg,.png,.pdf" style="display: none;" onchange="handleFileSelect(this)">
                                <div style="display: flex; align-items: center; gap: 15px;">
                                    <button type="button" onclick="this.parentElement.previousElementSibling.click()" style="padding: 8px 15px; cursor: pointer;">
                                        <%= __('fields.choose_file') %>
                                    </button>
                                    <span class="file-name-display" style="color: #666;"><%= __('fields.no_file_chosen') %></span>
                                </div>
                            </div>

                            <div class="location-wrapper" style="display: none; margin-top: 15px;">
                                <label style="display: block; font-weight: bold;"><%= __('fields.url_link') %></label>
                                <input type="url" name="physical_logical_location[]" class="form-control" placeholder="https://..." style="width: 100%; padding: 10px;">
                            </div>
                        </div>

                        <div style="text-align: right;">
                            <button type="button" class="btn btn-danger" onclick="removeMultimediaRow(this)"><%= __('fields.remove') %></button>
                        </div>
                    </div>
                </div>
            </div>

            <button type="button" id="add-multimedia" class="btn-add" style="padding: 12px; background-color: #28a745; color: white; border: none; width: 100%; cursor: pointer; border-radius: 4px;">
                <%= __('fields.add_another') %>
            </button>
        </div>
    </fieldset>

    <fieldset style="margin-top: 20px;">
        <legend><%= __('sections.recordcomplete') %></legend>
        <label>
            <input type="checkbox" name="recordcomplete" value="true">
            <strong><%= __('form.mark_complete') %></strong>
        </label>
    </fieldset>

    <div style="margin: 40px 0; text-align: center;">
        <button type="submit" id="mainSubmitBtn" style="padding: 15px 50px; font-size: 1.2rem; background-color: #0038b8; color: white; border: none; border-radius: 5px; cursor: pointer;">
            <%= __('submit') %>
        </button>
    </div>
  </form>

  <script>
    // --- MULTIMEDIA DYNAMICS ---
    function toggleUploadType(select) {
        const row = select.closest('.multimedia-row');
        const fileWrapper = row.querySelector('.file-wrapper');
        const urlWrapper = row.querySelector('.location-wrapper');
        const engType = select.options[select.selectedIndex].getAttribute('data-type-eng') || "";
        const isUrl = engType.includes('link') || engType.includes('url');

        fileWrapper.style.display = isUrl ? 'none' : 'block';
        urlWrapper.style.display = isUrl ? 'block' : 'none';
        
        if(isUrl) row.querySelector('.file-input').value = '';
        else row.querySelector('input[name="physical_logical_location[]"]').value = '';
    }

    function handleFileSelect(input) {
        const display = input.parentElement.querySelector('.file-name-display');
        display.textContent = input.files.length > 0 ? input.files[0].name : "<%= __('fields.no_file_chosen') %>";
    }

    function removeMultimediaRow(btn) {
        const rows = document.querySelectorAll('.multimedia-row');
        if (rows.length > 1) btn.closest('.multimedia-row').remove();
        else alert("At least one upload row is required.");
    }

    document.getElementById('add-multimedia').addEventListener('click', function() {
        const container = document.getElementById('multimedia-rows');
        const firstRow = container.querySelector('.multimedia-row');
        const newRow = firstRow.cloneNode(true);
        
        // Reset inputs
        newRow.querySelectorAll('input').forEach(i => i.value = '');
        newRow.querySelectorAll('select').forEach(s => s.selectedIndex = 0);
        newRow.querySelector('.file-name-display').textContent = "<%= __('fields.no_file_chosen') %>";
        newRow.querySelector('.location-wrapper').style.display = 'none';
        newRow.querySelector('.file-wrapper').style.display = 'block';
        
        container.appendChild(newRow);
    });

    // --- CATEGORY SYNC ---
    function syncTranslations(checkbox) {
        const idx = checkbox.getAttribute('data-index');
        const isChecked = checkbox.checked;
        document.getElementById('hidden_cat' + idx).value = isChecked ? checkbox.getAttribute('data-heb') : "";
        document.getElementById('hidden_cat' + idx + 'en').value = isChecked ? checkbox.getAttribute('data-eng') : "";
        document.getElementById('hidden_cat' + idx + 'ru').value = isChecked ? checkbox.getAttribute('data-rus') : "";
    }

    // --- DATE GROUP SYNC ---
    function syncDates() {
        document.querySelectorAll('.date-entry-group').forEach(group => {
            const day = group.querySelector('.day').value.padStart(2, '0');
            const month = group.querySelector('.month').value.padStart(2, '0');
            const year = group.querySelector('.year').value;
            const hiddenInput = group.querySelector('input[type="hidden"]');
            
            if (year && month !== '00' && day !== '00') {
                hiddenInput.value = `${year}-${month}-${day}`;
            }
        });
    }

    // --- FINAL VALIDATION ---
    document.getElementById('soldierForm').addEventListener('submit', function(e) {
        syncDates();
        const trans = document.getElementById('multimedia-translations').dataset;
        let isValid = true;
        let errors = [];

        // Check required fields (HTML5 'required' doesn't always show nicely)
        this.querySelectorAll('[required]').forEach(input => {
            if (!input.value) {
                isValid = false;
                input.style.borderColor = 'red';
            } else {
                input.style.borderColor = '#ccc';
            }
        });

        if (!isValid) {
            e.preventDefault();
            document.getElementById('error-summary').style.display = 'block';
            window.scrollTo(0, 0);
        }
    });
  </script>
</body>
</html>