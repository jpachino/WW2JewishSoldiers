<fieldset class="is-multimedia-container" style="border: 1px solid #ddd; padding: 20px; border-radius: 8px;">
    <legend style="padding: 0 10px; font-weight: bold;"><%= __('sections.uploads') %></legend>

    <div class="existing-multimedia" style="margin-bottom: 30px;">
        <h4 style="border-bottom: 1px solid #eee; padding-bottom: 10px; color: #333;"><%= __('form.current_files') %></h4>
        <table class="table" style="width: 100%; margin-top: 10px; border-collapse: collapse;">
            <thead>
                <tr style="background: #f8f9fa; text-align: left;">
                    <th style="padding: 10px; border-bottom: 2px solid #dee2e6;"><%= __('fields.description') %></th>
                    <th style="padding: 10px; border-bottom: 2px solid #dee2e6;"><%= __('fields.multimedia_type') %></th>
                    <th style="padding: 10px; border-bottom: 2px solid #dee2e6;"><%= __('fields.preview_link') || 'Preview/Link' %></th>
                </tr>
            </thead>
            <tbody>
                <% if (locals.multimedia && multimedia.length > 0) { %>
                    <% multimedia.forEach(item => { %>
                        <tr>
                            <td style="padding: 10px; border-bottom: 1px solid #eee;"><%= item.file_description %></td>
                            <td style="padding: 10px; border-bottom: 1px solid #eee;"><%= item.multimedia_type %></td>
                            <td style="padding: 10px; border-bottom: 1px solid #eee;">
                                <a href="<%= item.file_path %>" target="_blank" class="btn btn-sm btn-outline-info" style="text-decoration: none; padding: 4px 8px; border: 1px solid #17a2b8; color: #17a2b8; border-radius: 4px;">
                                    <%= __('buttons.view') || 'View' %>
                                </a>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="3" style="padding: 20px; text-align: center; color: #666;"><%= __('form.no_files_found') %></td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <div id="multimedia-translations" 
         data-err-ext="<%= __('errors.invalid_extension') %>"
