   <fieldset>
  <legend><%= __('sections.birthdeath') %></legend>

<label for="birthcountry"><%= __('fields.birthcountry') %></label>
<select name="birthcountry" class="mandatory" class="form-control">
    <option value="">--</option>
    <% countries.forEach(country => { 
        // 1. Map the locale to your DB column naming convention
        let displayTitle;
        if (locale === 'en') {
          displayTitle = country.title_eng;
        } else if (locale === 'ru') {
          displayTitle = country.title_rus;
        } else {
          displayTitle = country.title_heb;
        }

        // 2. Compare against the stored Hebrew value to maintain selection
        const isSelected = (soldier.birthcountry === country.title_heb) ? 'selected' : ''; 
    %>
      <option value="<%= country.id %>" <%= isSelected %>>
        <%= displayTitle %>
      </option>
    <% }) %>
  </select>
   
  <div class="trio-row">
          <div class="input-group">
