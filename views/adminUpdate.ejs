    if (locale === 'he') {
      return a.title_heb.localeCompare(b.title_heb, 'he');
    } else if (locale === 'en') {
      return a.title_eng.localeCompare(b.title_eng, 'en');
    } else if (locale === 'ru') {
      return a.title_rus.localeCompare(b.title_rus, 'ru');
    }
    return 0;
  });
%>
