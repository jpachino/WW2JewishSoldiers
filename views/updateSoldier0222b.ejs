<script>
document.addEventListener('DOMContentLoaded', () => {
    /**
     * 1. DATE VALIDATION & SYNC LOGIC
     */
    const dateGroups = document.querySelectorAll('.date-entry-group');
    const currentYear = new Date().getFullYear();

    window.syncDates = function() {
        document.querySelectorAll('.date-entry-group').forEach(group => {
            const dayInput = group.querySelector('.day');
            const monthInput = group.querySelector('.month');
            const yearInput = group.querySelector('.year');
            const hiddenInput = group.querySelector('input[type="hidden"]');
            
            if (dayInput && monthInput && yearInput && hiddenInput) {
                const day = dayInput.value.padStart(2, '0');
                const month = monthInput.value.padStart(2, '0');
                const year = yearInput.value;
                if (year && month !== '00' && day !== '00') {
                    hiddenInput.value = `${year}-${month}-${day}`;
                }
            }
        });
    };

    const getMaxDays = (month, year) => {
        const m = parseInt(month, 10);
        const y = parseInt(year, 10);
        if (!m) return 31;
        if (m === 2) {
            if (!y) return 29; 
            const isLeap = (y % 4 === 0 && y % 100 !== 0) || (y % 400 === 0);
            return isLeap ? 29 : 28;
        }
        return [4, 6, 9, 11].includes(m) ? 30 : 31;
    };

    const triggerDateError = (inputEl, groupEl, message) => {
        const errorSpan = groupEl.querySelector('.date-error-msg');
        if (inputEl) {
            inputEl.value = '';
            inputEl.classList.add('input-error');
            setTimeout(() => inputEl.classList.remove('input-error'), 800);
        }
        if (errorSpan) {
            errorSpan.textContent = message;
            setTimeout(() => { errorSpan.textContent = ''; }, 3500);
        }
    };

    const checkDateChronology = () => {
        const dobVal = document.getElementById('dob') ? document.getElementById('dob').value : null;
        const dodVal = document.getElementById('dod') ? document.getElementById('dod').value : null;

        if (dobVal && dodVal) {
            const parseToDate = (str) => {
                const parts = str.split('-');
                if (parts.length === 3) return new Date(parts[2], parts[1] - 1, parts[0]);
                return null;
            };
            const dobDate = parseToDate(dobVal);
            const dodDate = parseToDate(dodVal);
            if (dobDate && dodDate && dodDate < dobDate) {
                const dodGroup = document.getElementById('dod').closest('.date-entry-group');
                dodGroup.querySelectorAll('input[type="text"]').forEach(inp => inp.value = '');
                document.getElementById('dod').value = '';
                triggerDateError(null, dodGroup, "Date of Death cannot be before Date of Birth");
            }
        }
    };

    dateGroups.forEach(group => {
        const dayInp = group.querySelector('.day');
        const monthInp = group.querySelector('.month');
        const yearInp = group.querySelector('.year');
        const inputs = [dayInp, monthInp, yearInp];

        const validateAndSync = () => {
            let d = dayInp.value.trim(), m = monthInp.value.trim(), y = yearInp.value.trim();
            if (y !== '' && y.length === 4 && parseInt(y, 10) > currentYear) {
                triggerDateError(yearInp, group, `Year cannot exceed ${currentYear}`);
                y = '';
            }
            if (m !== '' && parseInt(m, 10) > 12) {
                triggerDateError(monthInp, group, "Month 01-12");
                m = '';
            }
            if (d !== '') {
                const max = getMaxDays(m, y);
                if (parseInt(d, 10) > max) {
                    triggerDateError(dayInp, group, `Max ${max} days`);
                    d = '';
                }
            }
            validateAndSyncFinal(group, d, m, y);
            checkDateChronology();
        };

        function validateAndSyncFinal(group, d, m, y) {
            const hiddenInput = group.querySelector('input[type="hidden"]');
            const padD = d ? d.padStart(2, '0') : '';
            const padM = m ? m.padStart(2, '0') : '';
            let final = '';
            if (y && m && d) final = `${padD}-${padM}-${y}`;
            else if (y && m) final = `${padM}-${y}`;
            else if (y) final = y;
            hiddenInput.value = final;
        }

        inputs.forEach((el, index) => {
            if(!el) return;
            el.addEventListener('input', () => {
                el.value = el.value.replace(/\D/g, '');
                validateAndSync();
                if (el.value.length >= el.maxLength && index < inputs.length - 1) inputs[index + 1].focus();
            });
            el.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace' && el.value === '' && index > 0) inputs[index - 1].focus();
            });
            el.addEventListener('blur', () => {
                if (el.value && el.value.length === 1 && !el.classList.contains('year')) el.value = el.value.padStart(2, '0');
                validateAndSync();
            });
        });
    });

    /**
     * 2. BATTLE LOGIC
     */
    const battleContainer = document.getElementById('battle-container');
    const addBattleBtn = document.getElementById('add-battle-entry');
    if (addBattleBtn && battleContainer) {
        const template = document.getElementById('battle-template');
        addBattleBtn.addEventListener('click', () => {
            const clone = document.importNode(template.content, true);
            battleContainer.appendChild(clone);
        });
        battleContainer.addEventListener('click', (e) => {
            if (e.target.classList.contains('remove-entry')) {
                const row = e.target.closest('.battle-row');
                const idInp = row.querySelector('input[name="battleId[]"]');
                if (idInp && idInp.value) {
                    const delInput = document.createElement('input');
                    delInput.type = 'hidden';
                    delInput.name = 'delete_battle_id[]';
                    delInput.value = idInp.value;
                    document.getElementById('soldierForm').appendChild(delInput);
                }
                row.remove();
            }
        });
    }

    /**
     * 3. SUBMIT VALIDATION & ANTI-SCRAMBLE
     */
    const soldierForm = document.getElementById('soldierForm');
    if (soldierForm) {
        soldierForm.addEventListener('submit', function(e) {
            if (typeof window.syncDates === 'function') window.syncDates(); 

            const transDiv = document.getElementById('multimedia-translations');
            const trans = transDiv ? transDiv.dataset : {};
            
            let isValid = true;
            const errorList = document.getElementById('error-list');
            const errorSummary = document.getElementById('error-summary');
            
            if (errorList) errorList.innerHTML = ''; 
            if (errorSummary) errorSummary.style.display = 'none';

            this.querySelectorAll('[required]').forEach(input => {
                if (!input.value.trim()) {
                    isValid = false;
                    input.style.borderColor = 'red';
                } else {
                    input.style.borderColor = '#ccc';
                }
            });

            const multimediaRows = document.querySelectorAll('.multimedia-row');
            multimediaRows.forEach((row, index) => {
                const descInput = row.querySelector('input[name="m_description"]');
                const fileInput = row.querySelector('.file-input');
                const urlInput = row.querySelector('input[name="physical_logical_location"]');
                const typeSelect = row.querySelector('.type-select');

                const hasFile = fileInput && fileInput.files.length > 0;
                const hasUrl = urlInput && urlInput.value.trim() !== "";
                const hasDesc = descInput && descInput.value.trim() !== "";
                // Requirement: If a file or URL is entered, description MUST be entered
            if ((hasFile || hasUrl) && !hasDesc) {
              isValid = false;
              if (descInput) {
                  descInput.style.borderColor = 'red';
                   descInput.placeholder = "<%= __('errors.description_required') %>";
              }
           addErrorMsg(`Row ${index + 1}: Description is required for the upload.`);
          }
              if (hasUrlContent) {
        
              urlInput.value = "URL"; 
          }
                if ((hasFile || hasUrl) && !hasDesc) {
                    isValid = false;
                    if (descInput) descInput.style.borderColor = 'red';
                    addErrorMsg(`Row ${index + 1}: ${trans.errMissingFields || 'Description required'}`);
                }

                if (hasFile && typeSelect) {
                    const fileName = fileInput.files[0].name.toLowerCase();
                    const selectedType = (typeSelect.options[typeSelect.selectedIndex].getAttribute('data-type-eng') || "").toLowerCase();
                    const isPdfFile = fileName.endsWith('.pdf');

                    if (selectedType.includes('pdf') && !isPdfFile) {
                        isValid = false;
                        addErrorMsg(`Row ${index + 1}: ${trans.errMismatchPdf}`);
                    } else if (selectedType.includes('image') && isPdfFile) {
                        isValid = false;
                        addErrorMsg(`Row ${index + 1}: ${trans.errMismatchImg}`);
                    }
                }
            });

            if (!isValid) {
                e.preventDefault();
                if (errorSummary) errorSummary.style.display = 'block';
                window.scrollTo({ top: 0, behavior: 'smooth' });
                return;
            }

            multimediaRows.forEach(row => {
                const d = row.querySelector('input[name="m_description"]');
                if (d && d.value.trim() === "") d.value = " "; 
            });

            function addErrorMsg(msg) {
                if (errorList) {
                    const li = document.createElement('li');
                    li.textContent = msg;
                    errorList.appendChild(li);
                }
            }
        });
    }

    /**
     * 4. ADD MULTIMEDIA ROW
     */
    const addMultiBtn = document.getElementById('add-multimedia');
    if (addMultiBtn) {
        addMultiBtn.addEventListener('click', function() {
            const container = document.getElementById('multimedia-rows');
            const rows = container.querySelectorAll('.multimedia-row');
            if (rows.length > 0) {
                const firstRow = rows[0];
                const newRow = firstRow.cloneNode(true);
                newRow.querySelectorAll('input').forEach(i => {
                    i.value = '';
                    i.style.borderColor = '#ccc';
                });
                const label = newRow.querySelector('.file-name-display');
                if(label) {
                    label.textContent = "<%= __('fields.no_file_chosen') %>";
                    label.style.color = "#666";
                }
                container.appendChild(newRow);
            }
        });
    }
}); // Correctly closed the DOMContentLoaded listener here

/**
 * 5. GLOBAL MULTIMEDIA FUNCTIONS
 */
function toggleUploadType(select) {
    const row = select.closest('.multimedia-row');
    const fileWrapper = row.querySelector('.file-wrapper');
    const urlWrapper = row.querySelector('.location-wrapper');
    const engType = (select.options[select.selectedIndex].getAttribute('data-type-eng') || "").toLowerCase();
    const isUrl = engType.includes('link') || engType.includes('url');

    fileWrapper.style.display = isUrl ? 'none' : 'block';
    urlWrapper.style.display = isUrl ? 'block' : 'none';
    
    if(isUrl) {
        const f = row.querySelector('.file-input');
        if(f) f.value = '';
        const lbl = row.querySelector('.file-name-display');
        if(lbl) lbl.textContent = "<%= __('fields.no_file_chosen') %>";
    } else {
        // Use the bracket notation to match your HTML
        const u = row.querySelector('input[name="physical_logical_location[]"]');
        if(u) u.value = '';
    }
}

function handleFileSelect(input) {
    const row = input.closest('.multimedia-row');
    const label = row.querySelector('.file-name-display');
    const mtrans = document.getElementById('multimedia-translations').dataset;
    const file = input.files[0];
    const typeSelect = row.querySelector('.type-select');
    const selectedTypeText = typeSelect ? typeSelect.options[typeSelect.selectedIndex].text.toLowerCase() : "";

    if (!file) {
        label.textContent = "<%= __('fields.no_file_chosen') %>";
        label.style.color = "#666";
        return;
    }

    const fileName = file.name.toLowerCase();
    const fileSizeMB = file.size / (1024 * 1024);
    let errorMessage = "";

    const isJpg = fileName.endsWith('.jpg') || fileName.endsWith('.jpeg') || fileName.endsWith('.png');
    const isPdf = fileName.endsWith('.pdf');

    // Multi-language keyword check
    const typeIsPicture = selectedTypeText.includes('picture') || selectedTypeText.includes('תמונה') || selectedTypeText.includes('фото');
    const typeIsDoc = selectedTypeText.includes('document') || selectedTypeText.includes('מסמך') || selectedTypeText.includes('документ') || selectedTypeText.includes('pdf');

    if (typeIsPicture && !isJpg) {
        errorMessage = mtrans.errMismatchImg || "Please upload an image (JPG/PNG)";
    } else if (typeIsDoc && !isPdf) {
        errorMessage = mtrans.errMismatchPdf || "Please upload a PDF";
    } else if (!isJpg && !isPdf) {
        errorMessage = mtrans.errExt || "Invalid file extension";
    } else if (fileSizeMB > 1.5) {
        errorMessage = isPdf ? (mtrans.errPdfSize || "PDF too large (Max 1.5MB)") : (mtrans.errImgSize || "Image too large (Max 1.5MB)");
    }

    if (errorMessage) {
        alert(errorMessage);
        input.value = ""; 
        label.textContent = "<%= __('fields.no_file_chosen') %>";
        label.style.color = "red";
    } else {
        label.textContent = file.name + " (" + fileSizeMB.toFixed(2) + "MB)";
        label.style.color = "green";
        input.style.borderColor = "#ccc";
    }
}

function removeMultimediaRow(btn) {
    const rows = document.querySelectorAll('.multimedia-row');
    if (rows.length > 1) btn.closest('.multimedia-row').remove();
    else alert("At least one upload row is required.");
}
</script>
