<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= __('search.title') %></title>
  <link rel="stylesheet" href="/styles/styles.css" />
</head>
<body>
  <header>
    <div class="container">
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap;">
        <h1><%= __('search.title') %></h1>

        <!-- 🌐 Language Selector 
        <form method="get" action="">
  <select name="lang" onchange="this.form.submit()">
    <option value="he" <%= (locale === 'he' ? 'selected' : '') %>>עברית</option>
    <option value="en" <%= (locale === 'en' ? 'selected' : '') %>>English</option>
    <option value="ru" <%= (locale === 'ru' ? 'selected' : '') %>>Русский</option>
  </select>
</form>-->
      </div>

      <nav>
        <a href="/"><%= __('nav.home') %></a>
        <!-- Hidden nav links for future use -->
        <!--<a href="/soldierlistFULL"><%= __('nav.soldierList') %></a>
        <a href="/addFull"><%= __('nav.addSoldier') %></a>
        <a href="/search"><%= __('nav.searchUpdate') %></a>-->
      </nav>
    </div>
  </header>
  </header>

  <% if (typeof req !== 'undefined' && req.query.saved == 'true') { %>
    <div class="success-box">
      <div class="success-content">
        <span class="success-icon">✅</span>
        <span><%= __('form.saved_success') || 'Record updated successfully!' %></span>
      </div>
    </div>
  <% } %>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const successBox = document.querySelector('.success-box');
      if (successBox) {
        setTimeout(() => {
          successBox.style.transition = 'opacity 1s ease';
          successBox.style.opacity = '0';
          setTimeout(() => successBox.remove(), 1000);
        }, 5000);
      }
    });
  </script>
</body>
  <!-- 🌐 Language Selector -->
        <form method="get" action="" style="margin-top: 2rem;">
  <select name="lang" onchange="this.form.submit()">
    <option value="he" <%= (locale === 'he' ? 'selected' : '') %>>עברית</option>
    <option value="en" <%= (locale === 'en' ? 'selected' : '') %>>English</option>
    <option value="ru" <%= (locale === 'ru' ? 'selected' : '') %>>Русский</option>
  </select>
</form>


  <div class="container">
    <form action="/searchResults" method="get"style="margin-top: 2rem;">
     <!-- <input
        type="text"
        name="firstname"
        placeholder="<%= __('search.enterFirstName') %>"
        value="<%= firstname || '' %>"
      />
      <input
        type="text"
        name="lastname"
        placeholder="<%= __('search.enterLastName') %>"
        value="<%= lastname || '' %>"
      />-->
      <input
        type="email"
        name="useremail"
        placeholder="<%= __('search.enterEmail') %>"
        value="<%= useremail || '' %>" required
      />
      <button type="submit"><%= __('search.searchButton') %></button>
    </form>
  </div>
  <style>
  .success-box {
    position: fixed;
    top: 30px; /* Moves it down away from the very top edge */
    left: 50%;
    transform: translateX(-50%);
    z-index: 99999; /* Ensures it sits on top of the header */
    background-color: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
    padding: 15px 40px;
    border-radius: 50px; /* Rounded pill shape looks better for popups */
    box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    font-weight: bold;
    display: flex;
    align-items: center;
    gap: 10px;
  }
</style>
</body>
</html>



