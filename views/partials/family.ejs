<fieldset>
  <legend><%=locals.t('family_legend') %></legend>
  <div class="trio-row">
    <div class="input-group">
      <label for="fathername"><%=locals.t('father_name') %>:</label>
      <input type="text" name="fathername" id="fathername" />
    </div>
    <div class="input-group">
      <label for="fathernameen"><%=locals.t('father_name_en') %>:</label>
      <input type="text" name="fathernameen" id="fathernameen" />
    </div>
    <div class="input-group">
      <label for="fathernameru"><%=locals.t('father_name_ru') %>:</label>
      <input type="text" name="fathernameru" id="fathernameru" />
    </div>
  </div>

  <div class="trio-row">
    <div class="input-group">
      <label for="mothername"><%=locals.t('mother_name') %>:</label>
      <input type="text" name="mothername" id="mothername" />
    </div>
    <div class="input-group">
      <label for="mothernameen"><%=locals.t('mother_name_en') %>:</label>
      <input type="text" name="mothernameen" id="mothernameen" />
    </div>
    <div class="input-group">
      <label for="mothernameru"><%=locals.t('mother_name_ru') %>:</label>
      <input type="text" name="mothernameru" id="mothernameru" />
    </div>
  </div>

  <div class="trio-row">
    <div class="input-group">
      <label for="calledby"><%=locals.t('called_by') %>:</label>
      <input type="text" name="calledby" id="calledby" />
    </div>
    <div class="input-group">
      <label for="calledbyen"><%=locals.t('called_by_en') %>:</label>
      <input type="text" name="calledbyen" id="calledbyen" />
    </div>
    <div class="input-group">
      <label for="calledbyru"><%=locals.t('called_by_ru') %>:</label>
      <input type="text" name="calledbyru" id="calledbyru" />
    </div>
  </div>
</fieldset>
