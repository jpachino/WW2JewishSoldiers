<fieldset>
  <legend><%=locals.t('idf_army_legend') %></legend>

  <div class="trio-row">
    <div class="input-group">
      <label for="fightingdesc"><%=locals.t('fighting_desc') %>:</label>
      <textarea name="fightingdesc" id="fightingdesc"></textarea>
    </div>
    <div class="input-group">
      <label for="fightingdescen"><%=locals.t('fighting_desc_en') %>:</label>
      <textarea name="fightingdescen" id="fightingdescen"></textarea>
    </div>
    <div class="input-group">
      <label for="fightingdescru"><%=locals.t('fighting_desc_ru') %>:</label>
      <textarea name="fightingdescru" id="fightingdescru"></textarea>
    </div>
  </div>

  <div class="single-row">
    <label for="idf_otherforce"><%=locals.t('idf_other_force') %>:</label>
    <input type="text" name="idf_otherforce" id="idf_otherforce" />
  </div>

  <div class="single-row">
    <label for="idf_otherrank"><%=locals.t('idf_other_rank') %>:</label>
    <input type="text" name="idf_otherrank" id="idf_otherrank" />
  </div>

  <div class="trio-row">
    <div class="input-group">
      <label for="idf_desc"><%=locals.t('idf_desc') %>:</label>
      <textarea name="idf_desc" id="idf_desc"></textarea>
    </div>
    <div class="input-group">
      <label for="idf_descen"><%=locals.t('idf_desc_en') %>:</label>
      <textarea name="idf_descen" id="idf_descen"></textarea>
    </div>
    <div class="input-group">
      <label for="idf_descru"><%=locals.t('idf_desc_ru') %>:</label>
      <textarea name="idf_descru" id="idf_descru"></textarea>
    </div>
  </div>

  <div class="single-row">
    <label for="idf_serviceplace"><%=locals.t('idf_service_place') %>:</label>
    <input type="text" name="idf_serviceplace" id="idf_serviceplace" />
  </div>

  <div class="single-row">
    <label for="idf_platoonname"><%=locals.t('idf_platoon_name') %>:</label>
    <input type="text" name="idf_platoonname" id="idf_platoonname" />
  </div>
</fieldset>
