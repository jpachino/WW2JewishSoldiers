<fieldset>
  <legend><%=locals.t('biography_participation_legend') %></legend>

  <div class="trio-row">
    <div class="input-group">
      <label for="biography"><%=locals.t('biography') %>:</label>
      <textarea name="biography" id="biography"></textarea>
    </div>
    <div class="input-group">
      <label for="biographyen"><%=locals.t('biography_en') %>:</label>
      <textarea name="biographyen" id="biographyen"></textarea>
    </div>
    <div class="input-group">
      <label for="biographyru"><%=locals.t('biography_ru') %>:</label>
      <textarea name="biographyru" id="biographyru"></textarea>
    </div>
  </div>

  <div class="single-row">
    <label for="otherparticipation"><%=locals.t('other_participation') %>:</label>
    <input type="text" name="otherparticipation" id="otherparticipation" />
  </div>

  <div class="trio-row">
    <div class="input-group">
      <label for="otherdecoration"><%=locals.t('other_decoration') %>:</label>
      <input type="text" name="otherdecoration" id="otherdecoration" />
    </div>
    <div class="input-group">
      <label for="otherdecorationen"><%=locals.t('other_decoration_en') %>:</label>
      <input type="text" name="otherdecorationen" id="otherdecorationen" />
    </div>
    <div class="input-group">
      <label for="otherdecorationru"><%=locals.t('other_decoration_ru') %>:</label>
      <input type="text" name="otherdecorationru" id="otherdecorationru" />
    </div>
  </div>
</fieldset>
