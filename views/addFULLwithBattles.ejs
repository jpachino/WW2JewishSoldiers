<script>
    let rowCount = 1; // Used for unique IDs on dynamic rows

    // 1. Pre-build the options string from the server-side data
    const typeOptionsHtml = `
        <option value="">-- <%= __('fields.select_option') %> --</option>
        <% if (locals.multimedia_type_TBL) { %>
            <% multimedia_type_TBL.forEach(type => { %>
                <option value="<%= type.title_heb %>">
                    <%= locale === 'he' ? type.title_heb : (locale === 'ru' ? type.title_rus : type.title_eng) %>
                </option>
            <% }) %>
        <% } %>
    `;

    // 2. Function to add a new multimedia row
    function addUploadRow() {
        const container = document.getElementById('multimedia-rows');
        const row = document.createElement('div');
        const currentId = rowCount++;
        
        row.className = 'multimedia-row border p-3 mb-3';
        row.style = "border: 1px solid #ccc; border-radius: 8px; margin-bottom: 15px; padding: 15px;";

        row.innerHTML = `
            <div class="row">
                <div class="col-md-3">
                    <label><%= __('fields.description') %></label>
                    <input type="text" name="m_description[]" class="form-control" required>
                </div>
                <div class="col-md-3">
                    <label><%= __('fields.multimedia_type') %></label>
                    <select name="m_type[]" class="form-control type-select">
                        ${typeOptionsHtml}
                    </select>
                </div>
                <div class="col-md-4">
                    <div class="file-wrapper">
                        <label><%= __('fields.file_upload') %></label>
                        <input type="file" name="m_files[]" class="file-input" accept="image/*,.pdf" 
                               style="display: none;" id="file_input_${currentId}" 
                               onchange="handleFileSelect(this, 'file_name_${currentId}')">
                        
                        <div class="d-flex align-items-center" style="gap: 10px;">
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="document.getElementById('file_input_${currentId}').click()">
                                <%= __('fields.choose_file') %>
                            </button>
                            <small id="file_name_${currentId}" class="text-muted">
                                <%= __('fields.no_file_chosen') %>
                            </small>
                        </div>
                    </div>
                    <div class="location-wrapper" style="display: none;">
                        <label><%= __('fields.url_link') %></label>
                        <input type="text" name="physical_logical_location[]" class="form-control" placeholder="https://...">
                    </div>
                </div>
                <div class="col-md-2 text-right">
                    <label>&nbsp;</label><br>
                    <button type="button" class="btn btn-danger" onclick="this.closest('.multimedia-row').remove()">
                         <%= __('fields.remove') %>
                    </button>
                </div>
            </div>
        `;
        container.appendChild(row);
    }

    // 3. Handle File Selection (Update Label + Trigger Preview)
    function handleFileSelect(input, spanId) {
        const label = document.getElementById(spanId);
        if (input.files && input.files[0]) {
            label.textContent = input.files[0].name;
            previewProfilePic(input);
        } else {
            label.textContent = "<%= __('fields.no_file_chosen') %>";
        }
    }

    // 4. Toggle Logic for File vs URL (Event Delegation)
    document.addEventListener('change', function (event) {
        if (event.target && event.target.classList.contains('type-select')) {
            const select = event.target;
            const row = select.closest('.multimedia-row');
            const fileWrapper = row.querySelector('.file-wrapper');
            const locationWrapper = row.querySelector('.location-wrapper');
            const selectedValue = select.value; 

            if (selectedValue.includes('URL') || selectedValue.includes('קישור')) {
                fileWrapper.style.display = 'none';
                locationWrapper.style.display = 'block';
                fileWrapper.querySelector('input').value = ''; 
            } else {
                fileWrapper.style.display = 'block';
                locationWrapper.style.display = 'none';
                locationWrapper.querySelector('input').value = '';
            }
        }
    });

    // 5. Profile Pic Preview logic
    function previewProfilePic(input) {
        const allInputs = document.querySelectorAll('.file-input');
        // Only preview if it's the first file input on the page
        if (input === allInputs[0] && input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                const previewImg = document.getElementById('profile-preview-img');
                const previewContainer = document.getElementById('profile-preview-container');
                previewImg.src = e.target.result;
                previewContainer.style.display = 'block';
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    // 6. Date Validation Helper
    function isValidDate(d) {
        if (!d) return true; // Allow empty
        const regex = /^(0?[1-9]|[12][0-9]|3[01])-(0?[1-9]|1[012])-(18|19|20)?[0-9]{2}$/;
        if (!regex.test(d)) return false;

        const [day, month, year] = d.split('-').map(Number);
        const jsDate = new Date(year, month - 1, day);

        return (
            jsDate.getFullYear() === year &&
            jsDate.getMonth() === month - 1 &&
            jsDate.getDate() === day
        );
    }

    // 7. Form Submit Listener
    document.getElementById("soldierForm").addEventListener("submit", function (e) {
        const dateFields = ["dob", "dod", "aliyadate"];
        for (let f of dateFields) {
            const el = document.getElementById(f);
            if(el) {
                const value = el.value.trim();
                if (!isValidDate(value)) {
                    alert(`❌ Invalid date format in ${f.toUpperCase()}.\nPlease use DD-MM-YYYY.`);
                    e.preventDefault();
                    return false;
                }
            }
        }
    });
</script>
</body>
