 <script>
  function maskDate(e) {
    let input = e.target.value.replace(/\D/g, ''); // Remove all non-digits
    let formatted = '';

    if (input.length > 0) {
      // Add first hyphen after DD
      formatted += input.substring(0, 2);
      if (input.length >= 3) {
        formatted += '-' + input.substring(2, 4);
      }
      if (input.length >= 5) {
        // Add second hyphen after MM
        formatted += '-' + input.substring(4, 8);
      }
    }
    e.target.value = formatted;
  }

  // Attach to all date fields
  const dateFields = ['dob', 'dod', 'aliyadate'];
  dateFields.forEach(id => {
    const el = document.getElementById(id);
    if (el) {
      el.addEventListener('input', maskDate);
      // Set max length to 10 (DD-MM-YYYY)
      el.setAttribute('maxlength', '10');
    }
  });
</script>


