<script>
document.addEventListener('DOMContentLoaded', () => {
    /**
     * 1. NEW TRIPLE-INPUT DATE LOGIC
     */
    const dateGroups = document.querySelectorAll('.date-entry-group');
    const currentYear = new Date().getFullYear();

    const getMaxDays = (month, year) => {
        const m = parseInt(month, 10);
        const y = parseInt(year, 10);
        if (!m) return 31;
        if (m === 2) {
            if (!y) return 29; 
            const isLeap = (y % 4 === 0 && y % 100 !== 0) || (y % 400 === 0);
            return isLeap ? 29 : 28;
        }
        return [4, 6, 9, 11].includes(m) ? 30 : 31;
    };

    const triggerError = (inputEl, groupEl, message) => {
        const errorSpan = groupEl.querySelector('.date-error-msg');
        if (inputEl) {
            inputEl.value = '';
            inputEl.classList.add('input-error');
            setTimeout(() => inputEl.classList.remove('input-error'), 800);
        }
        if (errorSpan) {
            errorSpan.textContent = message;
            setTimeout(() => { errorSpan.textContent = ''; }, 3500);
        }
    };

    const checkDateChronology = () => {
        const dobVal = document.getElementById('dob').value;
        const dodVal = document.getElementById('dod').value;

        if (dobVal && dodVal) {
            const dobParts = dobVal.split('-').reverse(); // [YYYY, MM, DD]
            const dodParts = dodVal.split('-').reverse(); // [YYYY, MM, DD]

            // CRITICAL: Only compare if the year part is a full 4-digit number
            // This prevents "1" or "19" from being compared to "1920"
            if (dobParts[0].length === 4 && dodParts[0].length === 4) {
                
                // Create comparable dates (Year, MonthIndex, Day)
                // Use '0' for month and '1' for day if missing to allow year-only comparison
                const dobDate = new Date(dobParts[0], (dobParts[1] || 1) - 1, dobParts[2] || 1);
                const dodDate = new Date(dodParts[0], (dodParts[1] || 1) - 1, dodParts[2] || 1);

                if (dodDate < dobDate) {
                    const dodGroup = document.getElementById('dod').closest('.date-entry-group');
                    const dodInputs = dodGroup.querySelectorAll('input[type="text"]');
                    
                    // Clear inputs so the user has to re-enter
                    dodInputs.forEach(inp => inp.value = '');
                    document.getElementById('dod').value = '';
                    
                    triggerError(null, dodGroup, "Date of Death cannot be before Date of Birth");
                }
            }
        }
    };

    dateGroups.forEach(group => {
        const hiddenInput = group.querySelector('input[type="hidden"]');
        const dayInp = group.querySelector('.day');
        const monthInp = group.querySelector('.month');
        const yearInp = group.querySelector('.year');
        const inputs = [dayInp, monthInp, yearInp];

        const validateAndSync = () => {
            let d = dayInp.value.trim(), m = monthInp.value.trim(), y = yearInp.value.trim();

            if (y !== '' && y.length === 4 && parseInt(y, 10) > currentYear) {
                triggerError(yearInp, group, `Year cannot exceed ${currentYear}`);
                y = '';
            }
            if (m !== '' && parseInt(m, 10) > 12) {
                triggerError(monthInp, group, "Month must be 01-12");
                m = '';
            }
            if (d !== '') {
                const max = getMaxDays(m, y);
                if (parseInt(d, 10) > max) {
                    triggerError(dayInp, group, m == 2 ? `Feb ${y || ''} has only ${max} days` : `This month has only ${max} days`);
                    d = '';
                }
            }

            const padD = d ? d.padStart(2, '0') : '';
            const padM = m ? m.padStart(2, '0') : '';
            let final = '';
            if (y && m && d) final = `${padD}-${padM}-${y}`;
            else if (y && m) final = `${padM}-${y}`;
            else if (y) final = y;

            hiddenInput.value = final;
            checkDateChronology();
        };

        inputs.forEach((el, index) => {
            el.addEventListener('input', () => {
                el.value = el.value.replace(/\D/g, '');
                validateAndSync();
                if (el.value.length >= el.maxLength && index < inputs.length - 1) inputs[index + 1].focus();
            });
            el.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace' && el.value === '' && index > 0) inputs[index - 1].focus();
            });
            el.addEventListener('blur', () => {
                if (el.value && el.value.length === 1 && !el.classList.contains('year')) el.value = el.value.padStart(2, '0');
                validateAndSync();
            });
        });

        if (hiddenInput.value) {
            let val = hiddenInput.value;
            if (val.length === 10 && val[4] === '-') {
                const p = val.split('-');
                val = `${p[2]}-${p[1]}-${p[0]}`;
            }
            const parts = val.split('-');
            if (parts.length === 3) [dayInp.value, monthInp.value, yearInp.value] = parts;
            else if (parts.length === 2) [monthInp.value, yearInp.value] = parts;
            else if (parts.length === 1) yearInp.value = parts[0];
        }
    });

    /**
     * 2. BATTLE LOGIC INIT
     */
    const battleContainer = document.getElementById('battle-container');
    const addBattleBtn = document.getElementById('add-battle-entry');
    if (addBattleBtn && battleContainer) {
        const template = document.getElementById('battle-template').content;
        addBattleBtn.addEventListener('click', () => {
            battleContainer.appendChild(document.importNode(template, true));
        });
        battleContainer.addEventListener('click', (e) => {
            if (e.target.classList.contains('remove-entry')) {
                const row = e.target.closest('.battle-row');
                const idInp = row.querySelector('input[name="battleId[]"]');
                if (idInp && idInp.value) row.querySelector('input[name="delete_battle_id[]"]').value = idInp.value;
                row.style.display = 'none';
            }
        });
    }
});

/**
 * 3. MULTIMEDIA LOGIC
 */
let rowCount = document.querySelectorAll('.multimedia-row').length;
const typeOptionsHtml = `
    <option value="">-- <%= __('fields.select_option') %> --</option>
    <% if (locals.multimedia_type_TBL) { %>
        <% multimedia_type_TBL.forEach(type => { %>
            <option value="<%= type.title_heb %>">
                <%= locale === 'he' ? type.title_heb : (locale === 'ru' ? type.title_rus : type.title_eng) %>
            </option>
        <% }) %>
    <% } %>
`;

function addUploadRow() {
    const container = document.getElementById('multimedia-rows');
    if (!container) return;
    const row = document.createElement('div');
    const currentId = rowCount++;
    row.className = 'multimedia-row border p-3 mb-3';
    row.style = "border: 1px solid #ccc; border-radius: 8px; margin-bottom: 15px; padding: 15px;";
    row.innerHTML = `
        <div class="row">
            <div class="col-md-3">
                <label><%= __('fields.description') %></label>
                <input type="text" name="m_description[]" class="form-control" required>
            </div>
            <div class="col-md-3">
                <label><%= __('fields.multimedia_type') %></label>
                <select name="m_type[]" class="form-control type-select">${typeOptionsHtml}</select>
            </div>
            <div class="col-md-4">
                <div class="file-wrapper">
                    <label><%= __('fields.file_upload') %></label>
                    <input type="file" name="m_files[]" id="file_input_${currentId}" style="display: none;" onchange="handleFileSelect(this, 'file_name_${currentId}')">
                    <div class="d-flex align-items-center" style="gap: 10px;">
                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="document.getElementById('file_input_${currentId}').click()"><%= __('fields.choose_file') %></button>
                        <small id="file_name_${currentId}" class="text-muted"><%= __('fields.no_file_chosen') %></small>
                    </div>
                </div>
                <div class="location-wrapper" style="display: none;">
                    <label><%= __('fields.url_link') %></label>
                    <input type="text" name="physical_logical_location[]" class="form-control" placeholder="https://...">
                </div>
            </div>
            <div class="col-md-2 text-right">
                <label>&nbsp;</label><br>
                <button type="button" class="btn btn-danger" onclick="this.closest('.multimedia-row').remove()"><%= __('fields.remove') %></button>
            </div>
        </div>`;
    container.appendChild(row);
}

function handleFileSelect(input, spanId) {
    document.getElementById(spanId).textContent = input.files && input.files[0] ? input.files[0].name : `<%= __('fields.no_file_chosen') %>`;
}

document.addEventListener('change', function (e) {
    if (e.target && e.target.classList.contains('type-select')) {
        const row = e.target.closest('.multimedia-row');
        const isUrl = e.target.options[e.target.selectedIndex].text.match(/URL|קישור|Link/i);
        row.querySelector('.file-wrapper').style.display = isUrl ? 'none' : 'block';
        row.querySelector('.location-wrapper').style.display = isUrl ? 'block' : 'none';
    }
});

/**
 * 4. FORM SUBMISSION VALIDATION
 */
document.getElementById("soldierForm").addEventListener("submit", function (e) {
    const errorSummary = document.getElementById('error-summary'), errorList = document.getElementById('error-list');
    errorSummary.style.display = 'none'; errorList.innerHTML = '';
    document.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));
    
    let errors = [];
    const markError = (ids, message) => {
        errors.push(message);
        ids.forEach(id => {
            const el = document.getElementById(id);
            if (el) el.classList.add('is-invalid');
        });
    };

    if (!['army', 'resistance', 'partizan'].some(id => document.getElementById(id).value)) markError(['army'], "Select at least one Service Type.");
    if (!['fname', 'fnameen', 'fnameru'].some(id => document.getElementById(id).value.trim())) markError(['fname'], "First Name is required.");
    if (!['lname', 'lnameen', 'lnameru'].some(id => document.getElementById(id).value.trim())) markError(['lname'], "Last Name is required.");
    if (!document.getElementById('gender').value) markError(['gender'], "Gender is required.");
    if (!document.getElementById('birthcountryId').value) markError(['birthcountryId'], "Birth Country is required.");

    // Date Format Check
    ["dob", "dod", "aliyadate"].forEach(f => {
        const val = document.getElementById(f).value.trim();
        if (val && !/^(\d{4}|(0[1-9]|1[0-2])-\d{4}|(0[1-9]|[12][0-9]|3[01])-(0[1-9]|1[0-2])-\d{4})$/.test(val)) {
            markError([f], `Invalid date format: ${f.toUpperCase()}`);
        }
    });

    if (errors.length > 0) {
        e.preventDefault();
        errors.forEach(err => {
            const li = document.createElement('li'); li.innerHTML = "❌ " + err;
            errorList.appendChild(li);
        });
        errorSummary.style.display = 'block';
        window.scrollTo({ top: errorSummary.offsetTop - 100, behavior: 'smooth' });
    }
});
</script>