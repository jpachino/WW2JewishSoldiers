            let displayLabel = c.title_heb;
            if (locale === 'en') displayLabel = c.title_eng;
            else if (locale === 'ru') displayLabel = c.title_rus;

            // 2. Identify the column name (cat1, cat2, etc.)
            let fieldName = "cat" + (index + 1);
            
            // 3. IMPORTANT: Check if this specific category is already saved in the DB
            // We check if the value in the soldier object is not empty
            let isChecked = (soldier[fieldName] && soldier[fieldName].length > 0) ? 'checked' : '';
        %>
            <div class="category-card">
                <input type="checkbox" 
                       name="<%= fieldName %>" 
                       id="check_<%= fieldName %>" 
                       value="<%= displayLabel %>"
                       <%= isChecked %>>
                
                <label for="check_<%= fieldName %>">
                    <%= displayLabel %>
                </label>
            </div>
        <% }) %>
    </div>
</div>

 
