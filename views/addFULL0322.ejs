<!DOCTYPE html>

<html lang="<%= locale %>" dir="<%= locale === 'he' ? 'rtl' : 'ltr' %>"></html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= __('nav.title1') %></title>
  <link rel="stylesheet" href="/styles/styles.css" />
  <style>
    /* Info Box Styling */
    .info-box { background-color: #f8f9fa; border-inline-start: 6px solid #007bff; padding: 20px; margin: 20px auto; max-width: 900px; border-radius: 6px; }
    
    /* Category Grid: Forces 4 per row on desktop */
    .category-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr); 
      gap: 15px;
      margin-top: 15px;
    }

    /* Date triple-input layout */
    .triple-input {
      display: flex;
      gap: 8px;
      align-items: center;
      max-width: 300px; /* Keeps it compact */
    }

    /* Responsive adjustments */
    @media (max-width: 1024px) {
      .category-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 600px) {
      .category-grid { grid-template-columns: 1fr; }
      .trio-row { flex-direction: column; gap: 0; }
    }
  </style>
</head>

