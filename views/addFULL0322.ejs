<script>
    /**
     * 1. GLOBAL MULTIMEDIA FUNCTIONS 
     * (Defined outside so they are accessible by HTML onclick/onchange attributes)
     */
    function toggleUploadType(select) {
        const row = select.closest('.multimedia-row');
        const fileWrapper = row.querySelector('.file-wrapper');
        const urlWrapper = row.querySelector('.location-wrapper');
        const engType = (select.options[select.selectedIndex].getAttribute('data-type-eng') || "").toLowerCase();
        const isUrl = engType.includes('link') || engType.includes('url');

        fileWrapper.style.display = isUrl ? 'none' : 'block';
        urlWrapper.style.display = isUrl ? 'block' : 'none';
        
        if(isUrl) {
            row.querySelector('.file-input').value = '';
            row.querySelector('.file-name-display').textContent = "<%= __('fields.no_file_chosen') %>";
        } else {
            const urlInput = row.querySelector('input[name="physical_logical_location[]"]');
            if(urlInput) urlInput.value = '';
        }
    }

    function handleFileSelect(input) {
    const row = input.closest('.multimedia-row');
    const label = row.querySelector('.file-name-display');
    const mtrans = document.getElementById('multimedia-translations').dataset;
    const file = input.files[0];
    
    // Get the type selected for THIS specific row
    const typeSelect = row.querySelector('.type-select');
    const selectedOption = typeSelect.options[typeSelect.selectedIndex];
    const engType = (selectedOption.getAttribute('data-type-eng') || "").toLowerCase();

    // Reset styles
    label.classList.remove('input-error-highlight');
    label.style.color = "#666";

    if (!file) {
        label.textContent = "<%= __('fields.no_file_chosen') %>";
        return;
    }

    const fileName = file.name.toLowerCase();
    const fileSizeMB = file.size / (1024 * 1024);
    let errorMessage = "";

    // STRICT: JPG/JPEG only (Removed .png)
    const isJpg = /\.(jpg|jpeg)$/i.test(fileName);
    const isPdf = fileName.endsWith('.pdf');

    const typeIsPicture = engType.includes('picture') || engType.includes('photo');
    const typeIsDoc = engType.includes('document');

    if (typeIsPicture && !isJpg) {
        errorMessage = mtrans.errMismatchImg || "Please upload a JPG image.";
    } else if (typeIsDoc && !isPdf) {
        errorMessage = mtrans.errMismatchPdf || "Please upload a PDF.";
    } else if (!isJpg && !isPdf) {
        errorMessage = mtrans.errExt || "Invalid extension. Only JPG and PDF allowed.";
    } else if (fileSizeMB > 1.5) {
        errorMessage = isPdf ? (mtrans.errPdfSize || "PDF too large (Max 1.5MB)") : (mtrans.errImgSize || "Image too large (Max 1.5MB)");
    }

    if (errorMessage) {
        alert(errorMessage);
        input.value = ""; 
        label.textContent = "<%= __('fields.no_file_chosen') %>";
        label.classList.add('input-error-highlight');
        label.style.color = "red";
    } else {
        label.textContent = file.name + " (" + fileSizeMB.toFixed(2) + "MB)";
        label.style.color = "green";
        label.classList.remove('input-error-highlight');
    }
}
   function removeMultimediaRow(btn) {
    // This allows removing any row without restrictions
    btn.closest('.multimedia-row').remove();
}

    function syncTranslations(checkbox) {
        const idx = checkbox.getAttribute('data-index');
        const isChecked = checkbox.checked;
        document.getElementById('hidden_cat' + idx).value = isChecked ? checkbox.getAttribute('data-heb') : "";
        document.getElementById('hidden_cat' + idx + 'en').value = isChecked ? checkbox.getAttribute('data-eng') : "";
        document.getElementById('hidden_cat' + idx + 'ru').value = isChecked ? checkbox.getAttribute('data-rus') : "";
    }

    /**
     * 2. DOM CONTENT LOADED (Logic that requires the page to be ready)
     */
    document.addEventListener('DOMContentLoaded', () => {
        const soldierForm = document.getElementById('soldierForm');
        const dateGroups = document.querySelectorAll('.date-entry-group');
        const currentYear = new Date().getFullYear();

        // --- DATE UTILITIES ---
        const getMaxDays = (month, year) => {
            const m = parseInt(month, 10);
            const y = parseInt(year, 10);
            if (!m) return 31;
            if (m === 2) {
                if (!y) return 29; 
                const isLeap = (y % 4 === 0 && y % 100 !== 0) || (y % 400 === 0);
                return isLeap ? 29 : 28;
            }
            return [4, 6, 9, 11].includes(m) ? 30 : 31;
        };

        const triggerDateError = (inputEl, groupEl, message) => {
            const errorSpan = groupEl.querySelector('.date-error-msg');
            if (inputEl) {
                inputEl.value = '';
                inputEl.classList.add('input-error');
                setTimeout(() => inputEl.classList.remove('input-error'), 800);
            }
            if (errorSpan) {
                errorSpan.textContent = message;
                errorSpan.style.color = 'red';
                setTimeout(() => { errorSpan.textContent = ''; }, 3500);
            }
        };

       window.syncDates = function() {
    document.querySelectorAll('.date-entry-group').forEach(group => {
        const dayInp = group.querySelector('.day');
        const monthInp = group.querySelector('.month');
        const yearInp = group.querySelector('.year');
        const hiddenInput = group.querySelector('input[type="hidden"]');
        
        if (dayInp && monthInp && yearInp && hiddenInput) {
            const d = dayInp.value.trim();
            const m = monthInp.value.trim();
            const y = yearInp.value.trim();

            let finalValue = "";
            
            // Format: DD-MM-YYYY (Text style)
            if (y && m && d) {
                finalValue = `${d.padStart(2, '0')}-${m.padStart(2, '0')}-${y}`;
            } else if (y && m) {
                finalValue = `${m.padStart(2, '0')}-${y}`;
            } else if (y) {
                finalValue = y;
            }
            
            hiddenInput.value = finalValue;
            console.log("Synced Group:", hiddenInput.name, "Value:", finalValue); // Debug line
        }
    });
};

        // --- DATE INPUT LISTENERS ---
        dateGroups.forEach(group => {
            const inputs = [group.querySelector('.day'), group.querySelector('.month'), group.querySelector('.year')];
            inputs.forEach((el, index) => {
                if(!el) return;
                el.addEventListener('input', () => {
                    el.value = el.value.replace(/\D/g, ''); 
                    let d = inputs[0].value, m = inputs[1].value, y = inputs[2].value;
                    if (y.length === 4 && parseInt(y) > currentYear) triggerDateError(inputs[2], group, "Invalid Year");
                    if (m && parseInt(m) > 12) triggerDateError(inputs[1], group, "Month 01-12");
                    if (d) {
                        const max = getMaxDays(m, y);
                        if (parseInt(d) > max) triggerDateError(inputs[0], group, `Max ${max} days`);
                    }
                    if (el.value.length >= el.maxLength && index < 2) inputs[index + 1].focus();
                });
                el.addEventListener('blur', () => {
                    if (el.value && el.value.length === 1 && !el.classList.contains('year')) el.value = el.value.padStart(2, '0');
                });
            });
        });

        // --- ADD MULTIMEDIA ROW ---
       // --- ADD MULTIMEDIA ROW ---
// --- ADD MULTIMEDIA ROW (Updated with 15-item limit) ---
document.getElementById('add-multimedia').addEventListener('click', function() {
    const container = document.getElementById('multimedia-rows');
    const template = document.getElementById('row-template');
    
    // 1. Check how many rows currently exist
    const currentRowsCount = container.querySelectorAll('.multimedia-row').length; 
    
    // 2. Prevent adding more if we hit 15
    if (currentRowsCount >= 15) {
      alert("<%= __('form.max_items_per_soldier') %>");
        return; 
    }
    console.log (currentRowsCount);
    if (template) {
        // 3. Clone and append the row
        const clone = template.content.cloneNode(true);
        container.appendChild(clone);
        
        // 4. Scroll the user to the new row
        container.lastElementChild.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
});
// --- SUBMIT VALIDATION (addFull.ejs) ---
soldierForm.addEventListener('submit', function(e) {
    window.syncDates(); 
    const mtrans = document.getElementById('multimedia-translations').dataset;
    let isValid = true;
    let firstInvalidField = null;

    // Reset all highlights
    this.querySelectorAll('input, select').forEach(el => {
        el.classList.remove('input-error-highlight');
        el.style.borderColor = '#ccc';
    });

    // 1. Validate General Required Fields
    this.querySelectorAll('[required]').forEach(input => {
        if (!input.value.trim()) {
            isValid = false;
            input.classList.add('input-error-highlight');
            if (!firstInvalidField) firstInvalidField = input;
        }
    });

    // 2. Validate Multimedia Rows
    const multimediaRows = document.querySelectorAll('.multimedia-row');
    if (multimediaRows.length > 15) {
    alert("<%= __('form.max_items_per_soldier') %>");
    e.preventDefault();
    return;
}
    for (let i = 0; i < multimediaRows.length; i++) {
        const row = multimediaRows[i];
        const rowNum = i + 1;
        
        const desc = row.querySelector('input[name="m_description[]"]');
        const typeSelect = row.querySelector('.type-select');
        const fileInput = row.querySelector('.file-input');
        const urlInput = row.querySelector('input[name="physical_logical_location[]"]');
        const fileDisplay = row.querySelector('.file-name-display');
        
        const hasFile = fileInput.files.length > 0;
        const hasUrl = urlInput && urlInput.value.trim() !== "";
        const hasType = typeSelect.value !== "";
        const hasDesc = desc.value.trim() !== "";

        // CHECK A: Missing Description
        if ((hasFile || hasUrl || hasType) && !hasDesc) {
            alert(`Row ${rowNum}: <%= __('fields.description') %> is required.`);
            desc.classList.add('input-error-highlight');
            if (!firstInvalidField) firstInvalidField = desc;
            isValid = false;
            break; 
        }

        // CHECK B: Missing Type
        if ((hasFile || hasUrl) && !hasType) {
            alert(`Row ${rowNum}: <%= __('fields.multimedia_type') %> is required.`);
            typeSelect.classList.add('input-error-highlight');
            if (!firstInvalidField) firstInvalidField = typeSelect;
            isValid = false;
            break; 
        }

        // CHECK C: Type selected but no File/Link
        if (hasType && !hasFile && !hasUrl) {
            alert(`Row ${rowNum}: Please provide a file or link.`);
            if (urlInput && urlInput.offsetParent !== null) {
                urlInput.classList.add('input-error-highlight');
            } else {
                fileDisplay.classList.add('input-error-highlight');
                fileDisplay.style.color = 'red';
            }
            if (!firstInvalidField) firstInvalidField = typeSelect;
            isValid = false;
            break;
        }

        // CHECK D: Final File Extension Check (Strict JPG/PDF)
        if (hasFile) {
            const fileName = fileInput.files[0].name.toLowerCase();
            const selectedOption = typeSelect.options[typeSelect.selectedIndex];
            const engType = (selectedOption.getAttribute('data-type-eng') || "").toLowerCase();
            
            const isPdfFile = fileName.endsWith('.pdf');
            const isJpgFile = /\.(jpg|jpeg)$/i.test(fileName); // No PNG

            if ((engType.includes('picture') || engType.includes('photo')) && !isJpgFile) {
                alert(`Row ${rowNum}: ${mtrans.errMismatchImg || 'Please upload a JPG'}`);
                isValid = false;
                typeSelect.classList.add('input-error-highlight');
                break;
            } else if (engType.includes('document') && !isPdfFile) {
                alert(`Row ${rowNum}: ${mtrans.errMismatchPdf || 'Please upload a PDF'}`);
                isValid = false;
                typeSelect.classList.add('input-error-highlight');
                break;
            }
        }
    }

    if (!isValid) {
        e.preventDefault(); 
        if (firstInvalidField) {
            firstInvalidField.focus();
            firstInvalidField.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
    } else {
        // Anti-scramble
        document.querySelectorAll('input[name="m_description[]"]').forEach(d => {
            if(!d.value.trim()) d.value = " "; 
        });
    }
});
    });
    document.addEventListener('change', function(e) {
    if (e.target && e.target.name === 'm_files[]') {
        const currentInput = e.target;
        const currentFile = currentInput.files[0];
        
        if (!currentFile) return;

        const allInputs = Array.from(document.querySelectorAll('input[type="file"][name="m_files[]"]'));
        
        // Find if this filename exists in any OTHER input
        const isDuplicate = allInputs.some(input => {
            return input !== currentInput && 
                   input.files[0] && 
                   input.files[0].name === currentFile.name;
        });

        if (isDuplicate) {
            // 1. Alert the user
            alert("❌ <%= __('form.duplicate_file_error') %>");
            
            // 2. FORCE the clear
            currentInput.value = ''; 
            
            // 3. Clear the visual display text (so it says "No file chosen" again)
            if (fileDisplay) {
                fileDisplay.textContent = "<%= __('fields.no_file_chosen') || 'No file chosen' %>";
                fileDisplay.style.color = 'inherit'; // Reset color if it was red
            }
            
            // 4. Visual feedback
            currentInput.style.outline = "2px solid red";
            setTimeout(() => { currentInput.style.outline = "none"; }, 2000);
        }
    }
});
</script>
</body>
</html>