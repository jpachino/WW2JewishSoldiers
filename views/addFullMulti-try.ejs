<!DOCTYPE html>
<html lang="<%= typeof t === 'function' ? t('langCode') : 'en' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <title><%=t('form.title') %></title>
  <link rel="stylesheet" href="/styles/styles.css">

  <style>
    .info-box {
      background-color: #f8f9fa;
      border-left: 6px solid #007bff;
      padding: 20px;
      margin: 20px auto;
      max-width: 800px;
      border-radius: 6px;
      font-family: Arial, sans-serif;
      line-height: 1.6;
      color: #333;
    }

    
    form {
      max-width: 1000px;
      margin: 0 auto;
    }

    fieldset {
      margin-top: 25px;
      border-radius: 6px;
      padding: 15px;
      border: 1px solid #ccc;
    }
  </style>
  <script>
    // This will run when the page loads
    document.addEventListener('DOMContentLoaded', function() {
      console.log('✅ Successfully loaded the Add Soldier form page!');
      // Optionally add a visual indicator on the page
      const notification = document.createElement('div');
      notification.style.backgroundColor = '#d4edda';
      notification.style.color = '#155724';
      notification.style.padding = '10px';
      notification.style.margin = '10px 0';
      notification.style.borderRadius = '4px';
     // notification.textContent = 'Form loaded successfully!';
      document.body.insertBefore(notification, document.querySelector('form'));
    });
  </script>
</head>
<body>
  <header>
    <div class="container">
       
      <h1><%=t('form.title') %></h1>
      <nav>
        <a href="/"><%=t('nav.home') %></a>
        <a href="/soldierlistFULL"><%=t('nav.soldierList') %></a>
        <a href="/addFULL"><%=t('nav.addSoldier') %></a>
        <a href="/search"><%=t('nav.search') %></a>
       </nav>
    </div>
  </header>
  <br><br><br><br><br>
  <!-- Container for image and text box side-by-side -->
<div class="info-container">
  
  <!-- Info box on the right -->
  <div class="info-box">
    <strong><%=t('form.infoHeader') %></strong><br><br>
    <%=t('form.infoText') %>
    <br><br>
    <%=t('form.sendMaterials') %> <a href="mailto:veteran@jwmww2.com">veteran@jwmww2.com</a>
    <br><br>
    <strong><%=t('form.thankYou') %></strong>
  </div>
</div>

 
      
