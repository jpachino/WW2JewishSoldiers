<!-- =================== Scripts =================== -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const container = document.getElementById('battle-container');
        const addBtn = document.getElementById('add-battle-entry');
        const template = document.getElementById('battle-template').content;

        // Add new battle row
        addBtn.addEventListener('click', () => {
            const newRow = document.importNode(template, true);
            container.appendChild(newRow);
        });

        // ✅ Updated: Handle removal by marking for deletion and hiding the row
        container.addEventListener('click', (e) => {
            if (e.target.classList.contains('remove-entry')) {
                const row = e.target.closest('.battle-row');
                if (row) {
                    const battleIdInput = row.querySelector('input[name="battleId[]"]');
                    const deleteInput = row.querySelector('input[name="delete_battle_id[]"]');

                    // If it's an existing record with an ID
                    if (battleIdInput && battleIdInput.value) {
                        deleteInput.value = battleIdInput.value;
                    }
                    
                    // Hide the row from view
                    row.style.display = 'none';

                    // Optional: Disable all inputs in the row to prevent accidental submission
                    //row.querySelectorAll('input, textarea, select').forEach(input => input.disabled = true);
                }
            }
        });
    });
</script>

<script>


  // Update uploaded file names
  function updateFileName() {
    const input = document.getElementById('files');
    const label = document.getElementById('file-label');
    if (input.files.length > 0) {
      label.textContent = Array.from(input.files).map(f => f.name).join(', ');
    } else {
      label.textContent = '<%= __("fields.noFilesChosen") %>';
    }
  }
</script>
