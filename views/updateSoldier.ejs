         <div class="trio-row">
          <div class="input-group">
      
          <label for="medal"><%= __('fields.medal') %>:</label>
          <select name="medal" id="medal">
          <option value="">{ <%= __('select') %> }</option>
          <% medals.forEach(m => { %>
          <option value="<%= m.id %>" <%= String(m.id) === String(soldier.medal) ? 'selected' : '' %>><%= m.title %></option>
          <% }); %>

        </select>
          <% medals.forEach(m => { %>
          <% if (String(m.id) === String(soldier.medal)) { %>
            <script>console.log('Matched medal ID: <%= m.id %> with soldier.medal = <%= soldier.medal %>');</script>
          <% } %>
          <% }); %>
      </div>
    <!-- Medal EN -->
    
    <div class="input-group">
