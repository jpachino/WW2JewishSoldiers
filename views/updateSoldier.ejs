<div class="form-section" style="margin-top: 25px; text-align: start;">
    <label class="roboto-bold" style="font-size: 1.0rem; border-bottom: 2px solid #ddd; padding-bottom: 5px; margin-bottom: 15px; display: block;">
        <%= __('fields.categories') %>
    </label>
<div class="category-grid">
<% 
    // 1. Get all Hebrew values currently saved in the 8 slots
    const currentHebrewValues = [
        (soldier.cat1 || "").trim(), (soldier.cat2 || "").trim(),
        (soldier.cat3 || "").trim(), (soldier.cat4 || "").trim(),
        (soldier.cat5 || "").trim(), (soldier.cat6 || "").trim(),
        (soldier.cat7 || "").trim(), (soldier.cat8 || "").trim()
    ];

    category.forEach((c, index) => { 
        const masterHeb = (c.title_heb || "").trim();
        const masterEng = (c.title_eng || "").trim();
        const masterRus = (c.title_rus || "").trim();

        // Check if THIS master category is one of the 8 saved in the DB
        const isChecked = currentHebrewValues.includes(masterHeb);
        
        // Find WHICH slot it is in (if any) so we can name the hidden field correctly
        // If it's not checked, we'll give it a temporary ID for the JS to handle
        let slotIndex = currentHebrewValues.indexOf(masterHeb) + 1;
        
        let displayLabel = masterHeb;
        if (locale === 'en') { displayLabel = masterEng; }
        else if (locale === 'ru') { displayLabel = masterRus; }
%>
    <div class="category-card">
        <input type="checkbox" 
               id="check_<%= index %>" 
               class="category-checkbox"
               data-heb="<%= masterHeb %>"
               data-eng="<%= masterEng %>"
               data-rus="<%= masterRus %>"
               onchange="syncAllCategories()" 
               <%= isChecked ? 'checked' : '' %>>
        
        <label for="check_<%= index %>">
            <%= displayLabel %>
        </label>
    </div>
<% }) %>

<% for(let i=1; i<=8; i++) { %>
    <input type="hidden" name="cat<%= i %>" id="hidden_cat<%= i %>" value="<%= soldier['cat' + i] || '' %>">
    <input type="hidden" name="cat<%= i %>en" id="hidden_cat<%= i %>en" value="<%= soldier['cat' + i + 'en'] || '' %>">
    <input type="hidden" name="cat<%= i %>ru" id="hidden_cat<%= i %>ru" value="<%= soldier['cat' + i + 'ru'] || '' %>">
<% } %>
</div>

