            <label for="relation_of_soldier_submitter"><%= __('fields.relation_of_soldier_submitter') %></label>
            <input type="text" id="relation_of_soldier_submitter" value="<%= soldier.relation_of_soldier_submitter || '' %>" readonly style="background-color: #e9ecef; cursor: not-allowed;" />
