      <fieldset>
  <legend><%= __('sections.uploads') %></legend>

  <label class="file-upload-label">
    <%= __('form.upload_files') %>
  </label>

  <div class="custom-file-input">
    <!-- Hide the default file input UI -->
    <input type="file" id="files" name="files" multiple onchange="updateFileName()" hidden />
    
    <!-- This button triggers the hidden input -->
    <button type="button" onclick="document.getElementById('files').click()">
      <%= __('form.select_files') %>
    </button>

    <!-- This shows the selected filenames or 'No files chosen' -->
    <span id="file-label"><%= __('form.no_file_chosen') %></span>
  </div>
  </fieldset>

