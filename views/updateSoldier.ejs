    <button type="submit" class="btn btn-primary btn-lg"><%= __('buttons.update') %></button>
</div>  
<script>
document.addEventListener('DOMContentLoaded', () => {
    /**
     * 1. DATE VALIDATION & SYNC LOGIC
     */
    // --- FIX: VISUAL DISPLAY ORDER (Handles 1, 2, or 3 parts) ---
  const currentYear = new Date().getFullYear();
  const dateGroupsOnLoad = document.querySelectorAll('.date-entry-group');
  const dateGroups = dateGroupsOnLoad;
  dateGroupsOnLoad.forEach(group => {
      const hiddenInput = group.querySelector('input[type="hidden"]');
      const dayInput = group.querySelector('.day');
      const monthInput = group.querySelector('.month');
      const yearInput = group.querySelector('.year');

      if (hiddenInput && hiddenInput.value) {
          const val = hiddenInput.value.trim();
          const parts = val.split('-'); 

          if (parts.length === 3) {
              // Standard 3-part date (Handles both YYYY-MM-DD and DD-MM-YYYY)
              if (parts[0].length === 4) {
                  yearInput.value = parts[0];
                  monthInput.value = parts[1];
                  dayInput.value = parts[2];
              } else {
                  dayInput.value = (parts[0] === '--') ? '' : parts[0];
                  monthInput.value = (parts[1] === '--') ? '' : parts[1];
                  yearInput.value = parts[2];
              }
          } 
          else if (parts.length === 2) {
              // NEW: Handle 2-part date (MM-YYYY) - This fixes your DOD!
              monthInput.value = parts[0];
              yearInput.value = parts[1];
              dayInput.value = '';
          } 
          else if (parts.length === 1 && val.length === 4) {
              // Only Year exists
              yearInput.value = val;
          }
      }
  });
 window.syncDates = function() {
    document.querySelectorAll('.date-entry-group').forEach(group => {
        const dayInp = group.querySelector('.day');
        const monthInp = group.querySelector('.month');
        const yearInp = group.querySelector('.year');
        const hiddenInput = group.querySelector('input[type="hidden"]');
        
        if (dayInp && monthInp && yearInp && hiddenInput) {
            const d = dayInp.value.trim();
            const m = monthInp.value.trim();
            const y = yearInp.value.trim();

            let finalValue = "";
            
            // This logic matches your addFull.ejs exactly:
            if (y && m && d) {
                // Full date: DD-MM-YYYY
                finalValue = `${d.padStart(2, '0')}-${m.padStart(2, '0')}-${y}`;
            } else if (y && m) {
                // Partial: MM-YYYY (This is your DOD fix!)
                finalValue = `${m.padStart(2, '0')}-${y}`;
            } else if (y) {
                // Year only: YYYY
                finalValue = y;
            }
            
            hiddenInput.value = finalValue;
        }
    });
};

    const getMaxDays = (month, year) => {
        const m = parseInt(month, 10);
        const y = parseInt(year, 10);
        if (!m) return 31;
        if (m === 2) {
            if (!y) return 29; 
            const isLeap = (y % 4 === 0 && y % 100 !== 0) || (y % 400 === 0);
            return isLeap ? 29 : 28;
        }
        return [4, 6, 9, 11].includes(m) ? 30 : 31;
    };

    const triggerDateError = (inputEl, groupEl, message) => {
        const errorSpan = groupEl.querySelector('.date-error-msg');
        if (inputEl) {
            inputEl.value = '';
            inputEl.classList.add('input-error');
            setTimeout(() => inputEl.classList.remove('input-error'), 800);
        }
        if (errorSpan) {
            errorSpan.textContent = message;
            setTimeout(() => { errorSpan.textContent = ''; }, 3500);
        }
    };

   const checkDateChronology = () => {
        const dobVal = document.getElementById('dob') ? document.getElementById('dob').value : null;
        const dodVal = document.getElementById('dod') ? document.getElementById('dod').value : null;

        if (dobVal && dodVal) {
            const parseToDate = (str) => {
                const parts = str.split('-');
                if (parts.length === 3) {
                    // Full Date: DD-MM-YYYY
                    return new Date(parts[2], parseInt(parts[1]) - 1, parseInt(parts[0]));
                } else if (parts.length === 2) {
                    // Partial Date: MM-YYYY -> Default to 1st of month
                    return new Date(parts[1], parseInt(parts[0]) - 1, 1);
                } else if (parts.length === 1 && str.length === 4) {
                    // Year Only: YYYY -> Default to Jan 1st
                    return new Date(str, 0, 1);
                }
                return null;
            };

            const dobDate = parseToDate(dobVal);
            const dodDate = parseToDate(dodVal);

            // If DOD is before DOB, it's an error
            if (dobDate && dodDate && dodDate < dobDate) {
                const dodGroup = document.getElementById('dod').closest('.date-entry-group');
                // Clear the boxes so the user has to fix it
                dodGroup.querySelectorAll('input[type="text"]').forEach(inp => inp.value = '');
                document.getElementById('dod').value = '';
                triggerDateError(null, dodGroup, "Date of Death cannot be before Date of Birth");
            }
        }
    };

    dateGroups.forEach(group => {
        const dayInp = group.querySelector('.day');
        const monthInp = group.querySelector('.month');
        const yearInp = group.querySelector('.year');
        const inputs = [dayInp, monthInp, yearInp];

        const validateAndSync = () => {
            let d = dayInp.value.trim(), m = monthInp.value.trim(), y = yearInp.value.trim();
            if (y !== '' && y.length === 4 && parseInt(y, 10) > currentYear) {
                triggerDateError(yearInp, group, `Year cannot exceed ${currentYear}`);
                y = '';
            }
            if (m !== '' && parseInt(m, 10) > 12) {
                triggerDateError(monthInp, group, "Month 01-12");
                m = '';
            }
            if (d !== '') {
                const max = getMaxDays(m, y);
                if (parseInt(d, 10) > max) {
                    triggerDateError(dayInp, group, `Max ${max} days`);
                    d = '';
                }
            }
            validateAndSyncFinal(group, d, m, y);
            checkDateChronology();
        };

        function validateAndSyncFinal(group, d, m, y) {
            const hiddenInput = group.querySelector('input[type="hidden"]');
            const padD = d ? d.padStart(2, '0') : '';
            const padM = m ? m.padStart(2, '0') : '';
            let final = '';
            if (y && m && d) final = `${padD}-${padM}-${y}`;
            else if (y && m) final = `${padM}-${y}`;
            else if (y) final = y;
            hiddenInput.value = final;
        }

        inputs.forEach((el, index) => {
            if(!el) return;
            el.addEventListener('input', () => {
                el.value = el.value.replace(/\D/g, '');
                validateAndSync();
                if (el.value.length >= el.maxLength && index < inputs.length - 1) inputs[index + 1].focus();
            });
            el.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace' && el.value === '' && index > 0) inputs[index - 1].focus();
            });
            el.addEventListener('blur', () => {
                if (el.value && el.value.length === 1 && !el.classList.contains('year')) el.value = el.value.padStart(2, '0');
                validateAndSync();
            });
        });
    });

    /**
     * 2. BATTLE LOGIC
     */
    const battleContainer = document.getElementById('battle-container');
    const addBattleBtn = document.getElementById('add-battle-entry');
    if (addBattleBtn && battleContainer) {
        const template = document.getElementById('battle-template');
        addBattleBtn.addEventListener('click', () => {
            const clone = document.importNode(template.content, true);
            battleContainer.appendChild(clone);
        });
        battleContainer.addEventListener('click', (e) => {
            if (e.target.classList.contains('remove-entry')) {
                const row = e.target.closest('.battle-row');
                const idInp = row.querySelector('input[name="battleId[]"]');
                if (idInp && idInp.value) {
                    const delInput = document.createElement('input');
                    delInput.type = 'hidden';
                    delInput.name = 'delete_battle_id[]';
                    delInput.value = idInp.value;
                    document.getElementById('soldierForm').appendChild(delInput);
                }
                row.remove();
            }
        });
    }

/**
     * 3. SUBMIT VALIDATION & ANTI-SCRAMBLE (With Red Highlights)
     */
    const soldierForm = document.getElementById('soldierForm');
    if (soldierForm) {
        soldierForm.addEventListener('submit', function(e) {
            if (typeof window.syncDates === 'function') window.syncDates();

            const transDiv = document.getElementById('multimedia-translations');
            const trans = transDiv ? transDiv.dataset : {};

            let isValid = true;
            let firstInvalidField = null;

            // --- RESET ALL HIGHLIGHTS ---
            // This clears previous red borders before re-checking
            this.querySelectorAll('input, select').forEach(el => {
                el.style.borderColor = '#ccc';
            });

            // 1. Validate standard required fields
            this.querySelectorAll('[required]').forEach(input => {
                if (!input.value.trim()) {
                    isValid = false;
                    input.style.borderColor = 'red';
                    if (!firstInvalidField) firstInvalidField = input;
                }
            });

            // 2. --- MULTIMEDIA ROW VALIDATION ---
            const multimediaRows = document.querySelectorAll('.multimedia-row');

            for (let i = 0; i < multimediaRows.length; i++) {
                const row = multimediaRows[i];
                const rowNum = i + 1;

                const descInput = row.querySelector('input[name="m_description[]"]');
                const fileInput = row.querySelector('.file-input');
                const urlInput = row.querySelector('input[name="physical_logical_location[]"]');
                const typeSelect = row.querySelector('.type-select');
                const fileDisplay = row.querySelector('.file-name-display');

                const hasFile = fileInput && fileInput.files.length > 0;
                const hasUrl = urlInput && urlInput.value.trim() !== "";
                const hasType = typeSelect && typeSelect.value !== "";
                const hasDesc = descInput && descInput.value.trim() !== "";

                // A. Missing description if other fields are filled
                if ((hasFile || hasUrl || hasType) && !hasDesc) {
                    alert(`Row ${rowNum}: <%= __('fields.description') %> is required.`);
                    isValid = false;
                    descInput.style.borderColor = 'red';
                    if (!firstInvalidField) firstInvalidField = descInput;
                    break;
                }

                // B. Missing Type if file/url is provided
                if ((hasFile || hasUrl) && !hasType) {
                    alert(`Row ${rowNum}: <%= __('fields.multimedia_type') %> is required.`);
                    isValid = false;
                    typeSelect.style.borderColor = 'red';
                    if (!firstInvalidField) firstInvalidField = typeSelect;
                    break;
                }

                // C. Type selected but NO file/url provided
                if (hasType && !hasFile && !hasUrl) {
                    alert(`Row ${rowNum}: Please provide a file or a link.`);
                    isValid = false;
                    if (urlInput && urlInput.offsetParent !== null) { // if URL is visible
                        urlInput.style.borderColor = 'red';
                        if (!firstInvalidField) firstInvalidField = urlInput;
                    } else if (fileDisplay) {
                        fileDisplay.style.color = 'red';
                        fileDisplay.textContent = "⚠️ <%= __('fields.no_file_chosen') %>";
                        if (!firstInvalidField) firstInvalidField = fileInput;
                    }
                    break;
                }

                // --- D. Final Submit Check (JPG vs PDF Only) ---
if (hasFile && typeSelect) {
    const fileName = fileInput.files[0].name.toLowerCase();
    const selectedOption = typeSelect.options[typeSelect.selectedIndex];
    const engType = (selectedOption.getAttribute('data-type-eng') || "").toLowerCase();
    
    const isPdfFile = fileName.endsWith('.pdf');
    const isJpgFile = /\.(jpg|jpeg)$/i.test(fileName); // No PNG allowed

    let mismatch = false;
    let specificError = "";

    if ((engType.includes('picture') || engType.includes('photo')) && !isJpgFile) {
        mismatch = true;
        specificError = "Only JPG images are allowed for Picture type.";
    } else if (engType.includes('document') && !isPdfFile) {
        mismatch = true;
        specificError = "Only PDF files are allowed for Document type.";
    } else if (!isPdfFile && !isJpgFile) {
        mismatch = true;
        specificError = "Unsupported file format. Please use JPG or PDF.";
    }

    if (mismatch) {
        alert(`Row ${rowNum}: ${specificError}`);
        isValid = false;
        typeSelect.classList.add('input-error-highlight');
        if (fileDisplay) fileDisplay.classList.add('input-error-highlight');
        if (!firstInvalidField) firstInvalidField = typeSelect;
        break; 
    }
}
            }

            if (!isValid) {
                e.preventDefault();
                if (firstInvalidField) {
                    firstInvalidField.focus();
                    firstInvalidField.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            } else {
                // Anti-scramble logic
                multimediaRows.forEach(row => {
                    const d = row.querySelector('input[name="m_description[]"]');
                    if (d && d.value.trim() === "") d.value = " ";
                });
            }
        });
    }
/**
 * 4. ADD MULTIMEDIA ROW
 */
const addMultiBtn = document.getElementById('add-multimedia');
if (addMultiBtn) {
    addMultiBtn.addEventListener('click', function() {
        const container = document.getElementById('multimedia-rows');
        const template = document.getElementById('multimedia-template');
        
        const existingCount = document.querySelectorAll('.multimedia-item').length; 
        const newRowsCount = container.querySelectorAll('.multimedia-row').length; 
        
        if ((existingCount + newRowsCount) >= 15) {
           alert("<%= __('form.max_items_per_soldier') %>");
            return; 
        }

        if (template) {
            const clone = document.importNode(template.content, true);
            container.appendChild(clone);
        }
    });
}
});
/**
 * 5. GLOBAL MULTIMEDIA FUNCTIONS (Updated to match Add Page logic)
 */
function toggleUploadType(select) {
    const row = select.closest('.multimedia-row');
    const fileWrapper = row.querySelector('.file-wrapper');
    const urlWrapper = row.querySelector('.location-wrapper');
    const selectedOption = select.options[select.selectedIndex];
    const engType = (selectedOption.getAttribute('data-type-eng') || "").toLowerCase();
    
    const isUrl = engType.includes('link') || engType.includes('url');

    fileWrapper.style.display = isUrl ? 'none' : 'block';
    urlWrapper.style.display = isUrl ? 'block' : 'none';
    
    if(isUrl) {
        const f = row.querySelector('.file-input');
        if(f) f.value = '';
        const lbl = row.querySelector('.file-name-display');
        if(lbl) lbl.textContent = "<%= __('fields.no_file_chosen') %>";
    } else {
        const u = row.querySelector('input[name="physical_logical_location[]"]');
        if(u) u.value = '';
    }
}

function handleFileSelect(input) {
    const row = input.closest('.multimedia-row');
    const label = row.querySelector('.file-name-display');
    const mtrans = document.getElementById('multimedia-translations').dataset;
    const file = input.files[0];
    // --- DUPLICATE FILENAME CHECK (EXISTING & NEW) ---
    if (file) {
        const fileName = file.name;
        
        // A. Check against files already saved in the database
        const existingDataEl = document.getElementById('existing-files-data');
        const savedFiles = JSON.parse(existingDataEl ? existingDataEl.dataset.filenames : "[]");
        
        if (savedFiles.includes(fileName)) {
            alert("❌  <%= __('form.duplicate_file_error') %>");
            input.value = ""; 
            label.textContent = "<%= __('fields.no_file_chosen') %>";
            label.style.color = "red";
            return;
        }

        // B. Check against other new files selected in this current session
        const allFileInputs = document.querySelectorAll('.file-input');
        let duplicateInForm = false;
        allFileInputs.forEach(otherInput => {
            if (otherInput !== input && 
                otherInput.files.length > 0 && 
                otherInput.files[0].name === fileName) {
                duplicateInForm = true;
            }
        });

        if (duplicateInForm) {
            
            alert("❌  <%= __('form.duplicate_file_error') %>");
            input.value = ""; 
            label.textContent = "<%= __('fields.no_file_chosen') %>";
            label.style.color = "red";
            return;
        }
    }
    // Get the type selected for THIS specific row
    const typeSelect = row.querySelector('.type-select');
    const selectedOption = typeSelect.options[typeSelect.selectedIndex];
    const engType = (selectedOption.getAttribute('data-type-eng') || "").toLowerCase();

    // Reset styles
    label.classList.remove('input-error-highlight');
    input.classList.remove('input-error-highlight');

    if (!file) {
        label.textContent = "<%= __('fields.no_file_chosen') %>";
        label.style.color = "#666";
        return;
    }

    const fileName = file.name.toLowerCase();
    const fileSizeMB = file.size / (1024 * 1024);
    let errorMessage = "";

    // STRICT: JPG/JPEG only (Removed png)
    const isJpg = /\.(jpg|jpeg)$/i.test(fileName);
    const isPdf = fileName.endsWith('.pdf');

    const typeIsPicture = engType.includes('picture') || engType.includes('photo');
    const typeIsDoc = engType.includes('document');

    // Validation Logic
    if (typeIsPicture && !isJpg) {
        errorMessage = mtrans.errMismatchImg || "Please upload a JPG image.";
    } else if (typeIsDoc && !isPdf) {
        errorMessage = mtrans.errMismatchPdf || "Please upload a PDF.";
    } else if (!isJpg && !isPdf) {
        errorMessage = mtrans.errExt || "Invalid extension. Only JPG and PDF allowed.";
    } else if (fileSizeMB > 1.5) {
        errorMessage = isPdf ? (mtrans.errPdfSize || "PDF too large (Max 1.5MB)") : (mtrans.errImgSize || "Image too large (Max 1.5MB)");
    }

    if (errorMessage) {
        alert(errorMessage);
        input.value = ""; 
        label.textContent = "<%= __('fields.no_file_chosen') %>";
        label.style.color = "red";
        
        // Add the red outline class
        label.classList.add('input-error-highlight');
    } else {
        label.textContent = file.name + " (" + fileSizeMB.toFixed(2) + "MB)";
        label.style.color = "green";
        input.style.borderColor = "#ccc";
        label.classList.remove('input-error-highlight');
    }
}
function syncAllCategories() {
    // 1. Clear all 8 hidden slots first
    for (let i = 1; i <= 8; i++) {
        document.getElementById(`hidden_cat${i}`).value = "";
        document.getElementById(`hidden_cat${i}en`).value = "";
        document.getElementById(`hidden_cat${i}ru`).value = "";
    }

    // 2. Find all checked boxes
    const checkedBoxes = document.querySelectorAll('.category-checkbox:checked');
    
    // 3. Fill the slots (up to 8)
    checkedBoxes.forEach((box, index) => {
        const slot = index + 1;
        if (slot <= 8) {
            document.getElementById(`hidden_cat${slot}`).value = box.dataset.heb;
            document.getElementById(`hidden_cat${slot}en`).value = box.dataset.eng;
            document.getElementById(`hidden_cat${slot}ru`).value = box.dataset.rus;
        } else {
            // Optional: Alert user they reached the limit
            box.checked = false; 
            alert("Maximum 8 categories allowed");
        }
    });
}
function removeMultimediaRow(btn) {
    // Allows removing any row
    btn.closest('.multimedia-row').remove();
}
</script>
</body>
</html>
