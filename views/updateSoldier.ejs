            <label for="placeofdeath"><%= __('fields.placeofdeath') %></label>
            <input type="text" name="placeofdeath" id="placeofdeath" value="<%= soldier.placeofdeath || '' %>" />
          </div>
          <div class="input-group">
            <label for="placeofdeathen"><%= __('fields.placeofdeathen') %></label>
            <input type="text" name="placeofdeathen" id="placeofdeathen" value="<%= soldier.placeofdeathen || '' %>" />
          </div>
          <div class="input-group">
            <label for="placeofdeathru"><%= __('fields.placeofdeathru') %></label>
            <input type="text" name="placeofdeathru" id="placeofdeathru" value="<%= soldier.placeofdeathru || '' %>" />
          </div>
        </div>
        <div class="trio-row">
          <div class="input-group">
            <label for="deathdetails"><%= __('fields.deathdetails') %></label>
            <select name="deathdetails" id="deathdetails">
              <option value="">-- בחר --</option>
              <option value="נפטר" <%= soldier.deathdetails === 'נפטר' ? 'selected' : '' %>>נפטר</option>
              <option value="נפל בקרב" <%= soldier.deathdetails === 'נפל בקרב' ? 'selected' : '' %>>נפל בקרב</option>
              <option value="נפל במילוי תפקידו" <%= soldier.deathdetails === 'נפל במילוי תפקידו' ? 'selected' : '' %>>נפל במילוי תפקידו</option>
              <option value="נרצח" <%= soldier.deathdetails === 'נרצח' ? 'selected' : '' %>>נרצח</option>
            </select>
          </div>
          <div class="input-group">
            <label for="deathdetailsen"><%= __('fields.deathdetailsen') %></label>
            <select name="deathdetailsen" id="deathdetailsen">
              <option value="">-- Select --</option>
              <option value="Deceased" <%= soldier.deathdetailsen === 'Deceased' ? 'selected' : '' %>>Deceased</option>
              <option value="Fallen in battle" <%= soldier.deathdetailsen === 'Fallen in battle' ? 'selected' : '' %>>Fallen in battle</option>
              <option value="Fallen in the line of duty" <%= soldier.deathdetailsen === 'Fallen in the line of duty' ? 'selected' : '' %>>Fallen in the line of duty</option>
              <option value="Murdered" <%= soldier.deathdetailsen === 'Murdered' ? 'selected' : '' %>>Murdered</option>
            </select>
          </div>
          <div class="input-group">
            <label for="deathdetailsru"><%= __('fields.deathdetailsru') %></label>
            <select name="deathdetailsru" id="deathdetailsru">
              <option value="">-- Выбрать --</option>
              <option value="Умер" <%= soldier.deathdetailsru === 'Умер' ? 'selected' : '' %>>Умер</option>
              <option value="Пал в бою" <%= soldier.deathdetailsru === 'Пал в бою' ? 'selected' : '' %>>Пал в бою</option>
              <option value="Погиб при исполнении служебных обязанностей" <%= soldier.deathdetailsru === 'Погиб при исполнении служебных обязанностей' ? 'selected' : '' %>>Погиб при исполнении служебных обязанностей</option>
              <option value="Убит" <%= soldier.deathdetailsru === 'Убит' ? 'selected' : '' %>>Убит</option>
            </select>
          </div>
        </div>
      </fieldset>

