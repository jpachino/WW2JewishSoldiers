<script>
    /**
     * 1. DATE MASKING
     * Supports YYYY, MM-YYYY, and DD-MM-YYYY
     */
    function maskDate(e) {
        let digits = e.target.value.replace(/\D/g, '');
        let formatted = '';
        const firstTwo = digits.substring(0, 2);
        const looksLikeYear = (firstTwo === '18' || firstTwo === '19' || firstTwo === '20');

        if (looksLikeYear && digits.length <= 4) {
            formatted = digits;
        } else {
            if (digits.length > 0) formatted += digits.substring(0, 2);
            if (digits.length > 2) formatted += '-' + digits.substring(2, 4);
            if (digits.length > 4) {
                if (digits.length > 6) {
                    formatted = digits.substring(0, 2) + '-' + digits.substring(2, 4) + '-' + digits.substring(4, 8);
                } else {
                    formatted = digits.substring(0, 2) + '-' + digits.substring(2, 6);
                }
            }
        }
        e.target.value = formatted;
    }

    /**
     * 2. MULTIMEDIA LOGIC
     */
    let rowCount = document.querySelectorAll('.multimedia-row').length;

    const typeOptionsHtml = `
        <option value="">-- <%= __('fields.select_option') %> --</option>
        <% if (locals.multimedia_type_TBL) { %>
            <% multimedia_type_TBL.forEach(type => { %>
                <option value="<%= type.title_heb %>">
                    <%= locale === 'he' ? type.title_heb : (locale === 'ru' ? type.title_rus : type.title_eng) %>
                </option>
            <% }) %>
        <% } %>
    `;

    function addUploadRow() {
        const container = document.getElementById('multimedia-rows');
        if (!container) return;

        const row = document.createElement('div');
        const currentId = rowCount++;
        row.className = 'multimedia-row border p-3 mb-3';
        row.style = "border: 1px solid #ccc; border-radius: 8px; margin-bottom: 15px; padding: 15px;";

        row.innerHTML = `
            <div class="row">
                <div class="col-md-3">
                    <label><%= __('fields.description') %></label>
                    <input type="text" name="m_description[]" class="form-control" required>
                </div>
                <div class="col-md-3">
                    <label><%= __('fields.multimedia_type') %></label>
                    <select name="m_type[]" class="form-control type-select">
                        ${typeOptionsHtml}
                    </select>
                </div>
                <div class="col-md-4">
                    <div class="file-wrapper">
                        <label><%= __('fields.file_upload') %></label>
                        <input type="file" name="m_files[]" class="file-input" style="display: none;" 
                               id="file_input_${currentId}" onchange="handleFileSelect(this, 'file_name_${currentId}')">
                        <div class="d-flex align-items-center" style="gap: 10px;">
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="document.getElementById('file_input_${currentId}').click()">
                                <%= __('fields.choose_file') %>
                            </button>
                            <small id="file_name_${currentId}" class="text-muted"><%= __('fields.no_file_chosen') %></small>
                        </div>
                    </div>
                    <div class="location-wrapper" style="display: none;">
                        <label><%= __('fields.url_link') %></label>
                        <input type="text" name="physical_logical_location[]" class="form-control" placeholder="https://...">
                    </div>
                </div>
                <div class="col-md-2 text-right">
                    <label>&nbsp;</label><br>
                    <button type="button" class="btn btn-danger" onclick="this.closest('.multimedia-row').remove()">
                        <%= __('fields.remove') %>
                    </button>
                </div>
            </div>
        `;
        container.appendChild(row);
    }

    function handleFileSelect(input, spanId) {
        const label = document.getElementById(spanId);
        if (input.files && input.files[0]) {
            label.textContent = input.files[0].name;
        } else {
            label.textContent = `<%= __('fields.no_file_chosen') %>`;
        }
    }

    // Toggle logic for Multimedia Type (URL vs File)
    document.addEventListener('change', function (event) {
        if (event.target && event.target.classList.contains('type-select')) {
            const select = event.target;
            const row = select.closest('.multimedia-row');
            const fileWrapper = row.querySelector('.file-wrapper');
            const locationWrapper = row.querySelector('.location-wrapper');
            const selectedText = select.options[select.selectedIndex].text;

            if (selectedText.includes('URL') || selectedText.includes('קישור') || selectedText.includes('Link')) {
                fileWrapper.style.display = 'none';
                locationWrapper.style.display = 'block';
                fileWrapper.querySelector('input').value = '';
            } else {
                fileWrapper.style.display = 'block';
                locationWrapper.style.display = 'none';
                locationWrapper.querySelector('input').value = '';
            }
        }
    });

    /**
     * 3. BATTLE LOGIC & INIT
     */
    document.addEventListener('DOMContentLoaded', () => {
        const container = document.getElementById('battle-container');
        const addBtn = document.getElementById('add-battle-entry');
        if (addBtn && container) {
            const template = document.getElementById('battle-template').content;
            addBtn.addEventListener('click', () => {
                const newRow = document.importNode(template, true);
                container.appendChild(newRow);
            });
            container.addEventListener('click', (e) => {
                if (e.target.classList.contains('remove-entry')) {
                    const row = e.target.closest('.battle-row');
                    if (row) {
                        const idInp = row.querySelector('input[name="battleId[]"]');
                        const delInp = row.querySelector('input[name="delete_battle_id[]"]');
                        if (idInp && idInp.value) delInp.value = idInp.value;
                        row.style.display = 'none';
                    }
                }
            });
        }

        // Attach mask to existing date inputs
        document.querySelectorAll('.date-input').forEach(input => {
            input.addEventListener('input', maskDate);
        });
    });

    /**
     * 4. FORM SUBMISSION & VALIDATION
     */
    document.getElementById("soldierForm").addEventListener("submit", function (e) {
        const errorSummary = document.getElementById('error-summary');
        const errorList = document.getElementById('error-list');
        
        errorSummary.style.display = 'none';
        errorList.innerHTML = '';
        document.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));
        
        let errors = [];
        let firstErrorElement = null;

        const markError = (ids, message) => {
            errors.push(message);
            ids.forEach(id => {
                const el = document.getElementById(id);
                if (el) {
                    el.classList.add('is-invalid');
                    if (!firstErrorElement) firstErrorElement = el;
                }
            });
        };

        // Service Type Validation
        if (!document.getElementById('army').value && !document.getElementById('resistance').value && !document.getElementById('partizan').value) {
            markError(['army', 'resistance', 'partizan'], "Missing Service Type: Please select at least one.");
        }

        // Name Validations
        if (!document.getElementById('fname').value.trim() && !document.getElementById('fnameen').value.trim() && !document.getElementById('fnameru').value.trim()) {
            markError(['fname', 'fnameen', 'fnameru'], "Missing First Name: Provide at least one language.");
        }
        if (!document.getElementById('lname').value.trim() && !document.getElementById('lnameen').value.trim() && !document.getElementById('lnameru').value.trim()) {
            markError(['lname', 'lnameen', 'lnameru'], "Missing Last Name: Provide at least one language.");
        }

        // Basic Fields
        if (!document.getElementById('gender').value) markError(['gender'], "Gender is required.");
        if (!document.getElementById('birthcountryId').value) markError(['birthcountryId'], "Birth Country is required.");

        // Submitter Validation
        const emailEl = document.getElementById('useremail');
        if (!emailEl.value.trim()) {
            markError(['useremail'], "Submitter Email is required.");
        } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailEl.value.trim())) {
            markError(['useremail'], "Submitter Email format is invalid.");
        }

        if (!document.getElementById('fname_soldier_submitter').value.trim()) markError(['fname_soldier_submitter'], "Submitter First Name is required.");
        if (!document.getElementById('lname_soldier_submitter').value.trim()) markError(['lname_soldier_submitter'], "Submitter Last Name is required.");
        if (!document.getElementById('phone_soldier_submitter').value.trim()) markError(['phone_soldier_submitter'], "Submitter Phone Number is required.");

        // Date Validation
        const dateFields = ["dob", "dod", "aliyadate"];
        const flexibleDateRegex = /^(\d{4}|(0[1-9]|1[0-2])-\d{4}|(0[1-9]|[12][0-9]|3[01])-(0[1-9]|1[0-2])-\d{4})$/;

        dateFields.forEach(f => {
            const el = document.getElementById(f);
            if (el && el.value.trim()) {
                if (!flexibleDateRegex.test(el.value.trim())) {
                    markError([f], `❌ <%= __('errors.invalid_date') %>: ${f.toUpperCase()} (YYYY, MM-YYYY, or DD-MM-YYYY)`);
                } 
            }
        });

        if (errors.length > 0) {
            e.preventDefault(); 
            errors.forEach(err => {
                const li = document.createElement('li');
                li.innerHTML = "❌ " + err; 
                errorList.appendChild(li);
            });

            errorSummary.style.display = 'block';
            const yOffset = -100; 
            const y = errorSummary.getBoundingClientRect().top + window.pageYOffset + yOffset;
            window.scrollTo({ top: y, behavior: 'smooth' });

            if (firstErrorElement) {
                setTimeout(() => { firstErrorElement.focus({ preventScroll: true }); }, 800);
            }
            return false;
        }
    });
</script>