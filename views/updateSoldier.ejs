            <input type="text" name="birthcityru" id="birthcityru" value="<%= soldier.birthcityru || '' %>" />
          </div>
        </div>
        <%
          const dob = soldier.dob;
          let formattedDob = '';
          if (dob) {
            const year = dob.getFullYear();
            const month = String(dob.getMonth() + 1).padStart(2, '0');
            const day = String(dob.getDate()).padStart(2, '0');
            formattedDob = `${year}-${month}-${day}`;
          }
          const dod = soldier.dod;
          let formattedDod = '';
          if (dod) {
            const year = dod.getFullYear();
            const month = String(dod.getMonth() + 1).padStart(2, '0');
            const day = String(dod.getDate()).padStart(2, '0');
            formattedDod = `${year}-${month}-${day}`;
          }
          const aliyadate = soldier.aliyadate;
          let formattedAliya = '';
          if (aliyadate) {
            const year = aliyadate.getFullYear();
            const month = String(aliyadate.getMonth() + 1).padStart(2, '0');
            const day = String(aliyadate.getDate()).padStart(2, '0');
            formattedAliya = `${year}-${month}-${day}`;
          }
        %>
        <label for="dob"><%= __('fields.dob') %>:</label>
        <input type="date" name="dob" id="dob" value="<%= formattedDob %>" />
        <label for="dod"><%= __('fields.dod') %>:</label>
        <input type="date" name="dod" id="dod" value="<%= formattedDod %>" />
        <label for="aliyadate"><%= __('fields.aliyadate') %>:</label>
        <input type="date" name="aliyadate" id="aliyadate" value="<%= formattedAliya %>" />
        <div class="trio-row">
