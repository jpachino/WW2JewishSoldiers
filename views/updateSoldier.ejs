<!--<%
function formatDDMMYYYY(raw) {
  if (!raw) return "";

  const parts = raw.trim().split(/[-/\.]/);
  if (parts.length !== 3) return "";

  let d, m, y;

  if (parts[0].length === 4) {
    // YYYY-MM-DD
    y = parts[0];
    m = parts[1];
    d = parts[2];
  } else {
    // DD-MM-YYYY
    d = parts[0];
    m = parts[1];
    y = parts[2];
  }

  const di = parseInt(d, 10);
  const mi = parseInt(m, 10);
  const yi = parseInt(y, 10);

  if (yi < 1800 || yi > 2100) return "";
  if (mi < 1 || mi > 12) return "";
  if (di < 1 || di > 31) return "";

  const test = new Date(`${yi}-${mi}-${di}`);
  if (
    test.getFullYear() !== yi ||
    test.getMonth() + 1 !== mi ||
    test.getDate() !== di
  ) return "";

  return `${String(di).padStart(2, "0")}-${String(mi).padStart(2, "0")}-${yi}`;
}

