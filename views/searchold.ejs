<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= __('searchResults') %></title>
  <link rel="stylesheet" href="/styles/styles.css">
</head>
<body>
  <header>
    <div class="container">
      <h1><%= __('searchResults') %></h1>
      <nav>
        <a href="/"><%= __('home') %></a>
        <a href="/soldierlistFULL"><%= __('soldierList') %></a>
        <a href="/addFULL"><%= __('addNewSoldier') %></a>
        <a href="/search"><%= __('searchUpdateSoldier') %></a>
      </nav>
    </div>
  </header>

  <!-- Language Dropdown -->
  <form method="GET" action="/search" style="margin: 20px;">
    <select name="lang" onchange="this.form.submit()">
      <option value="he" <%= locale === 'he' ? 'selected' : '' %>>עברית</option>
      <option value="en" <%= locale === 'en' ? 'selected' : '' %>>English</option>
      <option value="ru" <%= locale === 'ru' ? 'selected' : '' %>>Русский</option>
    </select>
  </form>

  <br><br><br><br><br><br>

  <div class="container">
    <% if (soldiers.length > 0) { %>
      <table>
        <thead>
          <tr>
            <th><%= __('fname') %></th>
            <th><%= __('lname') %></th>
            <th><%= __('birthcountry') %></th>
            <th><%= __('fathername') %></th>
            <th><%= __('dob') %></th>
            <th><%= __('dod') %></th>
            <th><%= __('id') %></th>
            <th><%= __('action') %></th>
          </tr>
        </thead>
        <tbody>
          <% soldiers.forEach(soldier => { %>
            <tr>
              <td><%= soldier.translatedFname %></td>
              <td><%= soldier.lname %></td>
              <td><%= soldier.birthcountry %></td>
              <td><%= soldier.fathername %></td>
              <td><%= soldier.dob %></td>
              <td><%= soldier.dod %></td>
              <td><%= soldier.id %></td>
              <td><a href="/updateSoldier/<%= soldier.id %>"><%= __('edit') %></a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <p><%= __('noSoldiersFound') %></p>
    <% } %>
    <a href="/search"><%= __('backToSearch') %></a>
  </div>
</body>
</html>

